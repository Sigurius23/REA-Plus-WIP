    },
    {
      "name": "analyze_function",
      "arguments": {
        "procedure": "0x1000cbb5c"
      },
      "label": "sidebar-layout"
    },
    {
      "name": "analyze_function",
      "arguments": {
        "procedure": "0x1000cbd08"
      },
      "label": "sidebar-update-layer"
