ions.length > 0) {\n    document.getElementById('container-missing-extensions').hidden = false;\n    showMissingExtensions(missingExtensions);\n    return;\n  }\n  document.getElementById('container-blocking-extensions').hidden = false;\n  showBlockingExtensions(window.loadTimeData.getValue('blockingExtensions'));\n};\n</script>\n</head>\n<body>\n  <div class=\"frame-blocked\">\n    <div class=\"information-container\">\n      <div class=\"enterprise-icon\"></div>\n      <div id=\"main-message\">\n        <div id=\"container-blocking-extensions\" hidden>\n          <h1 id=\"heading\">\n            $i18n{incognitoBlockedPageTitle}\n          </h1>\n          <p>\n            $i18n{incognitoBlockedMessage}\n          </p>\n          <ul id=\"blocking-extensions\">\n          </ul>\n          <p>\n            $i18n{incognitoBlockedInstructions}\n          </p>\n          <ol>\n            <li>\n              $i18nRaw{incognitoBlockedInstructionsStep1}\n            </li>\n            <li>\n              $i18nRaw{incognitoBlockedInstructionsStep2}\n            </li>\n            <li>\n              $i18nRaw{incognitoBlockedInstructionsStep3}\n            </li>\n            <li>\n              $i18nRaw{incognitoBlockedInstructionsStep4}\n            </li>\n          </ol>\n        </div>\n        <div id=\"container-missing-extensions\" hidden>\n          <h1>\n            $i18n{incognitoBlockedMissingExtensionsTitle}\n          </h1>\n          $i18nRaw{incognitoBlockedMissingExtensionsMessage}\n        </div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n",
