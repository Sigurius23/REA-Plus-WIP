      "__schema6": {
        "default": true,
        "description": "Decode recognized gzip/Chromium Brotli for the selected resource only; false returns stored bytes",
        "$ref": "#/$defs/__schema7"
      },
      "__schema7": {
        "type": "boolean"
      },
      "__schema8": {
        "default": 67108864,
        "type": "integer",
        "minimum": 15,
        "maximum": 536870912
