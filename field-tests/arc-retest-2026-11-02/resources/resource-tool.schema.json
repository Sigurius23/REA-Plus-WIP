{
  "name": "inspect_chromium_resources",
  "title": "Inspect Chromium Resources",
  "description": "Inspect a stable local Chromium DataPack v4/v5 (.pak) without launching a browser. Validates the complete bounded numeric index and direct aliases, then returns an ID-ordered page with original table/payload offsets, stored-byte SHA-256 and compression candidates. Select resource_id for complete bounded stored or decoded bytes, decoded SHA-256 and an optional text preview. Gzip and Chromium-envelope Brotli are decoded only for that selected ID; decode:false preserves stored bytes. No filenames/MIME types are invented, resources are never executed, and outer gzip packs are unsupported. Padding/sentinel/unclaimed ranges are preserved. Large complete Evidence uses retained export; no active target, engine or installation is required.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "$ref": "#/$defs/__schema0",
        "description": "Absolute path to an unwrapped Chromium DataPack v4/v5"
      },
      "offset": {
        "$ref": "#/$defs/__schema1",
        "description": "Resource identities to skip in ascending numeric ID order"
      },
      "limit": {
        "$ref": "#/$defs/__schema3"
      },
      "resource_id": {
        "$ref": "#/$defs/__schema4",
        "description": "Exact resource ID or alias whose complete bytes to read"
      },
      "decode": {
        "$ref": "#/$defs/__schema6",
        "description": "Decode recognized gzip/Chromium Brotli for the selected resource only; false returns stored bytes"
      },
      "max_file_bytes": {
        "$ref": "#/$defs/__schema8",
        "description": "Maximum permitted file bytes for this operation."
      },
      "max_resource_bytes": {
        "$ref": "#/$defs/__schema9",
        "description": "Maximum stored and decoded selected resource bytes; checked before bounded decompression"
      }
    },
    "required": [
      "path"
    ],
