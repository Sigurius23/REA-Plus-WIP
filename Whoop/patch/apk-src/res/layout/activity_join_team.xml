<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView android:id="@id/activity_joinTeam_background" android:src="@drawable/bg_blue_gradient" style="@style/Login.Background" />
    <LinearLayout android:orientation="vertical" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@id/activity_joinTeam_whoopLogo" android:layout_marginBottom="@dimen/Margin.Standard" style="@style/Login.Logo" />
        <TextView android:id="@id/activity_joinTeam_subtitle" android:text="@string/JoinTeam.Subtitle" style="@style/Login.Subtitle" />
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:clipChildren="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1.0">
            <LinearLayout android:layout_gravity="center_horizontal" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <FrameLayout android:id="@id/activity_joinTeam_userIconGroup" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <de.hdodenhof.circleimageview.CircleImageView android:layout_gravity="center" android:layout_width="120.0dp" android:layout_height="120.0dp" android:src="@color/Whoop.Black.QuarterOpacity" />
                    <de.hdodenhof.circleimageview.CircleImageView android:layout_gravity="center" android:id="@id/activity_joinTeam_userIcon" android:layout_width="108.0dp" android:layout_height="108.0dp" />
                </FrameLayout>
                <ImageView android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_arrow_back" android:rotation="180.0" android:layout_marginStart="@dimen/Margin.Double" android:layout_marginEnd="@dimen/Margin.Double" />
                <FrameLayout android:id="@id/activity_joinTeam_teamIconGroup" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <de.hdodenhof.circleimageview.CircleImageView android:layout_gravity="center" android:layout_width="120.0dp" android:layout_height="120.0dp" android:src="@color/Whoop.Black.QuarterOpacity" />
                    <de.hdodenhof.circleimageview.CircleImageView android:layout_gravity="center" android:id="@id/activity_joinTeam_teamIcon" android:layout_width="108.0dp" android:layout_height="108.0dp" />
                </FrameLayout>
            </LinearLayout>
            <TextView android:textSize="@dimen/text_size_semi_large" android:gravity="center" android:layout_gravity="center_horizontal" android:id="@id/activity_joinTeam_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@null" android:layout_marginBottom="@null" android:fontFamily="@font/alphabetic_font_bold" style="@style/Text" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@id/activity_joinTeam_buttonGroup" android:clipChildren="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/Margin.Triple" android:layout_marginStart="@null" android:layout_marginEnd="@null">
            <com.whoop.ui.pills.StrokedPillButton android:id="@id/activity_joinTeam_confirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_confirm" app:strokedPillColor="@color/Whoop.White" style="@style/Button.StrokedPill" />
            <com.whoop.ui.pills.StrokedPillButton android:id="@id/activity_joinTeam_decline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/Margin.Standard" android:text="@string/action_decline" app:strokedPillColor="@color/Whoop.Gray" style="@style/Button.StrokedPill" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
