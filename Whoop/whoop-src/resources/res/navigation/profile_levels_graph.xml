<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_levels_graph"
    app:startDestination="@+id/memberLevelsFragment">
    <fragment
        android:label="MemberLevelsFragment"
        android:name="com.whoop.profile.view.memberlevels.MemberLevelsFragment"
        android:id="@+id/memberLevelsFragment">
        <deepLink app:uri="android-app://com.whoop/levels?id={id}&amp;level={level}&amp;experience={experience}&amp;user_id={user_id}&amp;tier={tier}&amp;badge={badge}&amp;mini_badge={mini_badge}&amp;minimum_experience={minimum_experience}&amp;maximum_experience={maximum_experience}"/>
        <argument
            android:name="memberLevelData"
            app:argType="com.whoop.domain.model.memberlevels.MemberLevelProfileViewData"/>
    </fragment>
</navigation>
