<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/community_graph"
    app:startDestination="@+id/communityLandingFragment">
    <fragment
        android:label="Community Landing page"
        android:name="com.whoop.community.CommunityLandingHostFragment"
        android:id="@+id/communityLandingFragment">
        <argument
            android:name="teamsOnly"
            android:defaultValue="false"
            app:argType="boolean"/>
        <deepLink app:uri="android-app://com.whoop/communityLandingFragment?teamsOnly={teamsOnly}"/>
        <action
            android:id="@+id/action_communityLandingFragment_to_communityPendingFragment"
            app:destination="@+id/communityPendingFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_communityLandingFragment_to_teamCreateActivity"
            app:destination="@+id/teamCreateActivity"
            app:enterAnim="@anim/zoom_in"
            app:exitAnim="@anim/zoom_out_enter"
            app:popEnterAnim="@anim/zoom_in_exit"
            app:popExitAnim="@anim/zoom_out"/>
        <action
            android:id="@+id/action_communityLandingFragment_to_communityFragment"
            app:destination="@+id/communityFragment"
            app:enterAnim="@anim/zoom_in"
            app:exitAnim="@anim/zoom_out_enter"
            app:popEnterAnim="@anim/zoom_in_exit"
            app:popExitAnim="@anim/zoom_out"/>
        <action
            android:id="@+id/action_communityLandingFragment_to_inviteCodeActivity"
            app:destination="@+id/inviteCodeActivity"
            app:enterAnim="@anim/zoom_in"
            app:exitAnim="@anim/zoom_out_enter"
            app:popEnterAnim="@anim/zoom_in_exit"
            app:popExitAnim="@anim/zoom_out">
            <argument
                android:name="inviteCode"
                android:defaultValue=""/>
        </action>
        <action
            android:id="@+id/action_communityLandingFragment_to_communityShowInviteFragment"
            app:destination="@+id/communityShowInviteFragment"
            app:enterAnim="@anim/zoom_in"
            app:exitAnim="@anim/zoom_out_enter"
            app:popEnterAnim="@anim/zoom_in_exit"
            app:popExitAnim="@anim/zoom_out"/>
    </fragment>
    <fragment
        android:label="fragment_community_pending"
        android:name="com.whoop.community.CommunityPendingInviteFragment"
        android:id="@+id/communityPendingFragment">
        <action
            android:id="@+id/action_communityPendingFragment_to_communityLandingFragment"
            app:destination="@+id/communityLandingFragment"
            app:enterAnim="@anim/zoom_in"
            app:exitAnim="@anim/zoom_out_enter"
            app:popEnterAnim="@anim/zoom_in_exit"
            app:popExitAnim="@anim/zoom_out"/>
        <argument
            android:name="user_id"
            android:defaultValue="-1"/>
        <action
            android:id="@+id/action_communityPendingFragment_to_communityShowInviteFragment"
            app:destination="@+id/communityShowInviteFragment"
            app:enterAnim="@anim/zoom_in"
            app:exitAnim="@anim/zoom_out_enter"
            app:popEnterAnim="@anim/zoom_in_exit"
            app:popExitAnim="@anim/zoom_out"/>
    </fragment>
    <activity
        android:label="InviteCodeActivity"
        android:name="com.whoop.community.presentation.login.InviteCodeActivity"
        android:id="@+id/inviteCodeActivity">
        <deepLink app:uri="android-app://com.whoop/inviteCodeActivity?inviteCode={inviteCode}&amp;joinTeam={joinTeam}"/>
        <argument
            android:name="inviteCode"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="joinTeam"
            android:defaultValue="true"
            app:argType="boolean"/>
    </activity>
    <activity
        android:label="TeamCreateActivity"
        android:name="com.whoop.community.presentation.teams.TeamCreateActivity"
        android:id="@+id/teamCreateActivity"/>
    <fragment
        android:label="CommunityFragment"
        android:name="com.whoop.community.CommunityFragment"
        android:id="@+id/communityFragment">
        <deepLink app:uri="android-app://com.whoop/communityFragment?pillarType={pillarType}&amp;timePeriod={timePeriod}&amp;widgetUrl={widgetUrl}&amp;teamString={teamString}"/>
        <argument
            android:name="sortBy"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="team"
            android:defaultValue="@null"
            app:argType="com.whoop.domain.model.teams.Team"
            app:nullable="true"/>
        <argument
            android:name="startOnLeaderboards"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="pillarType"
            app:argType="integer"/>
        <argument
            android:name="timePeriod"
            app:argType="string"/>
        <action
            android:id="@+id/action_communityFragment_to_communityManageTeamFragment"
            app:destination="@+id/communityManageTeamFragment"/>
        <action
            android:id="@+id/action_communityFragment_to_communityAddMemberFragment"
            app:destination="@+id/communityAddMemberFragment"/>
        <action
            android:id="@+id/action_communityFragment_to_notificationSettingsFragment"
            app:destination="@+id/notificationSettingsFragment"/>
        <argument
            android:name="parentMessageId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="teamString"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="widgetUrl"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="sourceId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="CommunityShowInviteFragment"
        android:name="com.whoop.community.CommunityShowInviteFragment"
        android:id="@+id/communityShowInviteFragment">
        <argument
            android:name="invitePojoCode"
            android:defaultValue="@null"
            app:argType="com.whoop.domain.model.teams.DrawerDisplayInvite"
            app:nullable="true"/>
        <argument
            android:name="invitePojo"
            android:defaultValue="@null"
            app:argType="com.whoop.domain.model.teams.DrawerDisplayInvite"
            app:nullable="true"/>
        <argument
            android:name="sourceId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_communityShowInviteFragment_to_communityFragment"
            app:destination="@+id/communityFragment"
            app:enterAnim="@anim/zoom_in"
            app:exitAnim="@anim/zoom_out_enter"
            app:popEnterAnim="@anim/zoom_in_exit"
            app:popExitAnim="@anim/zoom_out"/>
    </fragment>
    <fragment
        android:label="CommunityAddMemberFragment"
        android:name="com.whoop.community.CommunityAddMemberFragment"
        android:id="@+id/communityAddMemberFragment">
        <argument
            android:name="team"
            app:argType="com.whoop.domain.model.teams.Team"/>
        <action
            android:id="@+id/action_communityAddMemberFragment_to_communityFragment"
            app:destination="@+id/communityFragment"
            app:popUpTo="@+id/communityFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="CommunityManageTeamFragment"
        android:name="com.whoop.community.CommunityManageTeamFragment"
        android:id="@+id/communityManageTeamFragment">
        <argument
            android:name="teamid"
            app:argType="integer"/>
        <action
            android:id="@+id/action_communityManageTeamFragment_to_communityLandingFragment"
            app:destination="@+id/communityLandingFragment"/>
        <action
            android:id="@+id/action_communityManageTeamFragment_to_communityRemoveMembersFragment"
            app:destination="@+id/communityRemoveMembersFragment"/>
        <action
            android:id="@+id/action_communityManageTeamFragment_to_communityFragment"
            app:destination="@+id/communityFragment"
            app:popUpTo="@+id/communityFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="CommunityRemoveMembersFragment"
        android:name="com.whoop.community.CommunityRemoveMembersFragment"
        android:id="@+id/communityRemoveMembersFragment">
        <argument
            android:name="isTransfer"
            app:argType="boolean"/>
        <argument
            android:name="teamid"
            app:argType="com.whoop.domain.model.teams.Team"/>
        <action
            android:id="@+id/action_communityRemoveMembersFragment_to_communityFragment"
            app:destination="@+id/communityFragment"
            app:popUpTo="@+id/communityFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <action
        android:id="@+id/action_global_community_landing"
        app:destination="@+id/communityLandingFragment"
        app:popUpTo="@+id/communityLandingFragment"
        app:popUpToInclusive="true"/>
    <action
        android:id="@+id/action_global_community_fragment"
        app:destination="@+id/communityFragment"
        app:popUpTo="@+id/communityFragment"
        app:popUpToInclusive="true"/>
    <action
        android:id="@+id/action_global_inviteCodeActivity"
        app:destination="@+id/inviteCodeActivity"/>
    <action
        android:id="@+id/action_global_inviteCodeActivity_iterable"
        app:destination="@+id/inviteCodeActivity"
        app:popUpTo="@+id/inviteCodeActivity"
        app:popUpToInclusive="true"/>
    <fragment
        android:label="NotificationSettingsFragment"
        android:name="com.whoop.community.presentation.chat.NotificationSettingsFragment"
        android:id="@+id/notificationSettingsFragment">
        <argument
            android:name="team"
            app:argType="com.whoop.domain.model.teams.Team"/>
    </fragment>
</navigation>
