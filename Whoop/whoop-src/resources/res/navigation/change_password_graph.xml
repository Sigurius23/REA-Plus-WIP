<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/change_password_graph"
    app:startDestination="@+id/changePasswordFragmentV2">
    <fragment
        android:label="ChangePasswordFragment"
        android:name="com.whoop.changepassword.view.ChangePasswordV2Fragment"
        android:id="@+id/changePasswordFragmentV2">
        <deepLink app:uri="android-app://com.whoop/changePassword"/>
    </fragment>
    <fragment
        android:label="PasswordResetFragment"
        android:name="com.whoop.changepassword.view.reset.PasswordResetFragment"
        android:id="@+id/passwordResetFragment">
        <deepLink app:uri="android-app://com.whoop/resetPassword?resetToken={resetToken}&amp;isExpired={isExpired}&amp;email={email}"/>
        <argument
            android:name="resetToken"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isExpired"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="email"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
</navigation>
