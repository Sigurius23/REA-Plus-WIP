<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stress_session_graph"
    app:startDestination="@+id/stressSessionFragment">
    <fragment
        android:label="StressSessionFragment"
        android:name="com.whoop.stress.view.StressSessionFragment"
        android:id="@+id/stressSessionFragment">
        <deepLink app:uri="android-app://com.whoop/stress-session?sessionType={sessionType}"/>
