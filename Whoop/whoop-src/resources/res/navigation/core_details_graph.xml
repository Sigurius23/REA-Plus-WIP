<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/core_details_graph"
    app:startDestination="@+id/core_details_fragment">
    <fragment
        android:label="CoreDetailsFragment"
        android:name="com.whoop.core.details.view.CoreDetailsFragment"
        android:id="@+id/core_details_fragment">
        <argument
            android:name="entryPoint"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="activityType"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="newHome"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="activityIdV2"
            app:argType="string"
            app:nullable="false"/>
        <deepLink app:uri="android-app://com.whoop/coreDetailsFragment/?entryPoint={entryPoint}&amp;activityType={activityType}&amp;newHome={newHome}&amp;activityIdV2={activityIdV2}"/>
    </fragment>
</navigation>
