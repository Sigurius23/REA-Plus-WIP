<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/grantPermissionsContainer"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/grantPermissionsImageView"
        android:layout_width="@dimen/stream_ui_attachment_dialog_permission_image_size"
        android:layout_height="@dimen/stream_ui_attachment_dialog_permission_image_size"
        android:scaleType="centerCrop"/>
    <TextView
        android:textAppearance="@style/StreamUiTextAppearance.BodyBold"
        android:textColor="@color/stream_ui_accent_blue"
        android:id="@+id/grantPermissionsTextView"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/stream_ui_spacing_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"/>
</LinearLayout>
