<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_data_widget_0"
    android:background="@color/chat_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/Margin.Standard"
    android:paddingEnd="@dimen/Margin.Standard">
    <ImageView
        android:id="@+id/share_data_close"
        android:padding="@dimen/Margin.Half"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/action_back"
        android:layout_marginStart="@dimen/Margin.Double"
        app:layout_constraintBottom_toBottomOf="@+id/share_data_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/share_data_label"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/share_data_label"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:text="@string/community_share_data"
        android:textAllCaps="true"
        android:paddingStart="@dimen/Margin.Double"
        android:paddingEnd="@dimen/Margin.Double"
        app:layout_constraintEnd_toStartOf="@+id/share_data_refresh"
        app:layout_constraintStart_toEndOf="@+id/share_data_close"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AmaTitleTextStyle"/>
    <ImageView
        android:id="@+id/share_data_refresh"
        android:padding="@dimen/Margin.Standard"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_share_data_refresh"
        android:contentDescription="@string/action_back"
        app:layout_constraintBottom_toBottomOf="@+id/share_data_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/share_data_label"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/category_recyclerview"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/Margin.Double"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_data_label"/>
    <com.whoop.p069ui.ThrobberView
        android:id="@+id/data_widget_throbber_view"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/data_widget_error_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_data_widget_error_state"/>
</androidx.constraintlayout.widget.ConstraintLayout>
