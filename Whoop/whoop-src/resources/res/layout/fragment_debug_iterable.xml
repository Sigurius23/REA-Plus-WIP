<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:tag="layout/fragment_debug_iterable_0"
    android:background="@drawable/main_background_gradient_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/main_background_gradient_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/backIcon"
            android:layout_width="?android:attr/actionBarSize"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="center"
            android:contentDescription="@string/action_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"/>
        <TextView
            android:gravity="center"
            android:id="@+id/title"
            android:text="@string/iterable"
            app:layout_constraintBottom_toBottomOf="@+id/backIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/backIcon"
            style="@style/Headline4"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/health_monitor_iterable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/SettingLandingItem">
            <com.whoop.p069ui.views.ColoredImageView
                android:id="@+id/health_monitor_icon"
                android:layout_width="@dimen/Settings.IconSize"
                android:layout_height="@dimen/Settings.IconSize"
                android:src="@drawable/ic_health_monitor_heart_beat"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:text="@string/health_monitor"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/health_monitor_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SettingsItemLabel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/coaching_landing_iterable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/health_monitor_iterable"
            style="@style/SettingLandingItem">
            <com.whoop.p069ui.views.ColoredImageView
                android:id="@+id/coaching_landing_icon"
                android:layout_width="@dimen/Settings.IconSize"
                android:layout_height="@dimen/Settings.IconSize"
                android:src="@drawable/ic_coaching"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:text="@string/coaching"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/coaching_landing_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SettingsItemLabel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/journal_reproductive_iterable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coaching_landing_iterable"
            style="@style/SettingLandingItem">
            <com.whoop.p069ui.views.ColoredImageView
                android:id="@+id/journal_reproductive_icon"
                android:layout_width="@dimen/Settings.IconSize"
                android:layout_height="@dimen/Settings.IconSize"
                android:src="@drawable/ic_survey_input"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:text="@string/journal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/journal_reproductive_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SettingsItemLabel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/strength_trainer_iterable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/journal_reproductive_iterable"
            style="@style/SettingLandingItem">
            <com.whoop.p069ui.views.ColoredImageView
                android:id="@+id/strength_trainer_icon"
                android:layout_width="@dimen/Settings.IconSize"
                android:layout_height="@dimen/Settings.IconSize"
                android:src="@drawable/ic_activity"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:text="@string/fab_workout_library"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/strength_trainer_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SettingsItemLabel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
