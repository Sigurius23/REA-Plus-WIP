<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_reactangle_round_corner_pink_gradient"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/sleep_coach_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_sleep_coach_navigation"
        android:contentDescription="@string/sleep_coach_alarm_status"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/sleep_coach_onboarding_title"
        android:layout_marginStart="15dp"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/sleep_coach_icon"
        app:layout_constraintStart_toEndOf="@+id/sleep_coach_icon"
        app:layout_constraintTop_toTopOf="@+id/sleep_coach_icon"
        style="@style/Headline5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
