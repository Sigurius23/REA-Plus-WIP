<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/mentionListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/emptyContainer"
        android:paddingTop="40dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/emptyImage"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:src="@drawable/stream_ui_ic_mentions_empty"/>
        <TextView
            android:textAppearance="@style/StreamUiTextAppearance.Body"
            android:textColor="@color/stream_ui_text_color_secondary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/emptyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/stream_ui_mention_list_empty"
            android:maxLines="1"
            android:textDirection="locale"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
