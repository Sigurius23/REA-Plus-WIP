<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_select_team_empty_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/select_team_empty_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="0x7f07000e"
        android:src="@drawable/ic_empty_select_team"
        android:contentDescription="@string/community_ama_network_error_cd"
        app:layout_constraintBottom_toTopOf="@+id/select_team_empty_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/select_team_empty_title"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/Margin.Double"
        android:text="@string/community_no_team_available"
        app:layout_constraintBottom_toTopOf="@+id/select_team_empty_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/select_team_empty_icon"
        style="@style/Headline5"/>
    <TextView
        android:textColor="@color/white_50"
        android:gravity="center_horizontal"
        android:id="@+id/select_team_empty_description"
        android:paddingBottom="@dimen/Margin.Double"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.StandardAndHalf"
        android:text="@string/community_no_team_available_description"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        android:paddingHorizontal="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/select_team_empty_title"
        style="@style/Paragraph2"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textColor="@color/Whoop.Green.Vibrant"
        android:id="@+id/select_team_discover_teams"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:text="@string/community_discover_teams"
        android:layout_marginStart="@dimen/Margin.Triple"
        android:layout_marginEnd="@dimen/Margin.Triple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/select_team_empty_description"
        app:strokedPillStrokeColor="@color/Whoop.Green.Vibrant"
        app:strokedPillStrokeWidth="2dp"
        style="@style/AmaStrokedPillButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
