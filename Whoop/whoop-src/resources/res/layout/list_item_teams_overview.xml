<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/Margin.Standard">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/itemLayoutAbout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <TextView
            android:textSize="12sp"
            android:id="@+id/itemAboutLabelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="@string/about"
            style="@style/Teams.SectionLabel"/>
        <TextView
            android:id="@+id/itemAboutSubText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Teams.Data"/>
        <com.whoop.p069ui.pills.StrokedPillButton
            android:textAppearance="@style/Whoop.Text.H1.White"
            android:id="@+id/itemAboutAddButton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/Margin.Standard"
            android:text="@string/add_description"
            android:textAllCaps="true"
            android:layout_marginEnd="@dimen/Margin.Standard"
            app:strokedPillColor="@color/Whoop.Black"
            app:strokedPillNormalAlpha="1"
            app:strokedPillStrokeColor="@color/Whoop.White"
            app:strokedPillUseStaticAlpha="false"
            style="@style/Button.Flat"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/itemLayoutSharing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <TextView
            android:textSize="12sp"
            android:id="@+id/itemSharingLabelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="@string/data_sharing"
            style="@style/Teams.SectionLabel"/>
        <TextView
            android:id="@+id/itemSharingSubText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Teams.Data"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:id="@+id/itemMembersLabelText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/data_sharing"
        style="@style/Teams.SectionLabel"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/itemAddMembersButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="@dimen/Margin.Standard"
            app:srcCompat="@drawable/ic_add_members"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/Whoop.Red"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/community_add_members"
            style="@style/Teams.UserName"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/itemMember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/itemMemberImage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/Margin.Standard"
                app:srcCompat="@drawable/ic_add_activity"/>
            <TextView
                android:textSize="9dp"
                android:textColor="@color/Whoop.Gray.SlightlyDark"
                android:gravity="center"
                android:id="@+id/itemMemberAdmin"
                android:background="@color/Whoop.White"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="12dp"
                android:layout_marginTop="32dp"
                android:text="@string/community_admin"
                android:textAllCaps="true"
                android:fontFamily="@font/alphabetic_font_bold"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:id="@+id/itemMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Teams.UserName"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/Whoop.Gray"
                android:id="@+id/itemMemberText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Teams.Data"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
