<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.whoop.whooplive.selfie.OverlayView
        android:id="@+id/view_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.whoop.whooplive.live.views.LiveOverlayView
            android:id="@+id/view_selfie_live"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.whoop.whooplive.selfie.DraggableViewGroup
            android:id="@+id/view_selfie_draggableSmallDials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:dragLimitBottom="150dp"
            app:dragLimitLeft="64dp"
            app:dragLimitRight="64dp"
            app:dragLimitTop="80dp"
            app:maxScale="1.5"
            app:minScale="0.5"
            app:syncWithSiblings="false">
            <RelativeLayout
                android:id="@+id/view_overlay_smallDials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/Margin.Double"
                android:paddingEnd="@dimen/Margin.Double">
                <com.whoop.p069ui.ProgressDialLayout
                    android:id="@+id/view_selfie_strainDialMini"
                    android:layout_alignParentStart="true"
                    app:progressDialLayoutEndColor="@color/Whoop.Gradient.Blue.End"
                    app:progressDialLayoutStartColor="@color/Whoop.Gradient.Blue.Start"
                    style="@style/WhoopSelfieDialCircle.Small">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/view_selfie_strainTextMini"
                            style="@style/WhoopSelfieDialValue.Small"/>
                    </LinearLayout>
                </com.whoop.p069ui.ProgressDialLayout>
                <TextView
                    android:text="@string/whooplive_Strain.DayStrain"
                    android:layout_below="@+id/view_selfie_strainDialMini"
                    android:layout_alignStart="@+id/view_selfie_strainDialMini"
                    android:layout_alignEnd="@+id/view_selfie_strainDialMini"
                    style="@style/WhoopSelfieDialLabel.Small"/>
                <com.whoop.p069ui.ProgressDialLayout
                    android:id="@+id/view_selfie_recoveryDialMini"
                    android:layout_centerHorizontal="true"
                    app:progressDialLayoutEndColor="@color/Whoop.Gradient.Blue.End"
                    app:progressDialLayoutStartColor="@color/Whoop.Gradient.Blue.Start"
                    style="@style/WhoopSelfieDialCircle.Small">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/view_selfie_recoveryTextMini"
                            style="@style/WhoopSelfieDialValue.Small"/>
                    </LinearLayout>
                </com.whoop.p069ui.ProgressDialLayout>
                <TextView
                    android:text="@string/whooplive_title_recovery"
                    android:layout_below="@+id/view_selfie_recoveryDialMini"
                    android:layout_alignStart="@+id/view_selfie_recoveryDialMini"
                    android:layout_alignEnd="@+id/view_selfie_recoveryDialMini"
                    style="@style/WhoopSelfieDialLabel.Small"/>
                <com.whoop.p069ui.ProgressDialLayout
                    android:id="@+id/view_selfie_sleepDialMini"
                    android:layout_alignParentEnd="true"
                    style="@style/WhoopSelfieDialCircle.Small">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/view_selfie_sleepTextMini"
                            style="@style/WhoopSelfieDialValue.Small"/>
                    </LinearLayout>
                </com.whoop.p069ui.ProgressDialLayout>
                <TextView
                    android:text="@string/whooplive_Sleep.HoursOfSleep"
                    android:layout_below="@+id/view_selfie_sleepDialMini"
                    android:layout_marginStart="-10dp"
                    android:layout_marginEnd="-10dp"
                    android:layout_alignStart="@+id/view_selfie_sleepDialMini"
                    android:layout_alignEnd="@+id/view_selfie_sleepDialMini"
                    style="@style/WhoopSelfieDialLabel.Small"/>
            </RelativeLayout>
        </com.whoop.whooplive.selfie.DraggableViewGroup>
        <com.whoop.whooplive.selfie.DraggableViewGroup
            android:id="@+id/view_selfie_draggableStrainDial"
            style="@style/WhoopDraggableDial">
            <com.whoop.p069ui.ProgressDialLayout
                android:id="@+id/view_selfie_strainDial"
                app:progressDialLayoutEndColor="@color/Whoop.Gradient.Blue.End"
                app:progressDialLayoutStartColor="@color/Whoop.Gradient.Blue.Start"
                style="@style/WhoopSelfieDialCircle.Large">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView style="@style/WhoopLogo"/>
                    <TextView
                        android:id="@+id/view_selfie_strainText"
                        style="@style/WhoopSelfieDialValue.Large"/>
                    <TextView
                        android:text="@string/whooplive_Strain.DayStrain"
                        style="@style/WhoopSelfieDialLabel.Large"/>
                </LinearLayout>
            </com.whoop.p069ui.ProgressDialLayout>
        </com.whoop.whooplive.selfie.DraggableViewGroup>
        <com.whoop.whooplive.selfie.DraggableViewGroup
            android:id="@+id/view_selfie_draggableRecoveryDial"
            app:syncWithSiblings="true"
            style="@style/WhoopDraggableDial">
            <com.whoop.p069ui.ProgressDialLayout
                android:id="@+id/view_selfie_recoveryDial"
                app:progressDialLayoutColor="@color/Whoop.Green"
                style="@style/WhoopSelfieDialCircle.Large">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView style="@style/WhoopLogo"/>
                    <TextView
                        android:id="@+id/view_selfie_recoveryText"
                        style="@style/WhoopSelfieDialValue.Large"/>
                    <TextView
                        android:textSize="16dp"
                        android:text="@string/whooplive_title_recovery"
                        style="@style/WhoopSelfieDialLabel.Large"/>
                </LinearLayout>
            </com.whoop.p069ui.ProgressDialLayout>
        </com.whoop.whooplive.selfie.DraggableViewGroup>
        <com.whoop.whooplive.selfie.DraggableViewGroup
            android:id="@+id/view_selfie_draggableSleepDial"
            app:syncWithSiblings="true"
            style="@style/WhoopDraggableDial">
            <com.whoop.p069ui.ProgressDialLayout
                android:id="@+id/view_selfie_sleepDial"
                style="@style/WhoopSelfieDialCircle.Large">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView style="@style/WhoopLogo"/>
                    <TextView
                        android:id="@+id/view_selfie_sleepText"
                        style="@style/WhoopSelfieDialValue.Large"/>
                    <TextView
                        android:text="@string/whooplive_Sleep.HoursOfSleep"
                        style="@style/WhoopSelfieDialLabel.Large"/>
                </LinearLayout>
            </com.whoop.p069ui.ProgressDialLayout>
        </com.whoop.whooplive.selfie.DraggableViewGroup>
    </com.whoop.whooplive.selfie.OverlayView>
</androidx.constraintlayout.widget.ConstraintLayout>
