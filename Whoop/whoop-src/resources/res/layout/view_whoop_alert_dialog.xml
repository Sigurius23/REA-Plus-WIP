<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_slightly_huge"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/whoop_alert_dialog_header_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_bold"
        android:letterSpacing="0.1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_standard"
        android:textColor="@color/black_50"
        android:gravity="center"
        android:id="@+id/whoop_alert_dialog_body_header_text"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/alphabetic_font_semibold"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/whoop_alert_dialog_header_text"/>
    <com.whoop.p069ui.pills.StrokedPillFrameLayout
        android:id="@+id/whoop_alert_dialog_negative_action_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/whoop_alert_dialog_positive_action_layout"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/whoop_alert_dialog_body_header_text"
        app:strokedPillColor="@color/white"
        app:strokedPillStrokeColorOverride="@color/Whoop.Black"
        app:strokedPillUseStaticAlpha="false">
        <TextView
            android:textSize="@dimen/text_size_standard"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/whoop_alert_dialog_negative_action_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/action_no"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"/>
    </com.whoop.p069ui.pills.StrokedPillFrameLayout>
    <com.whoop.p069ui.pills.StrokedPillFrameLayout
        android:id="@+id/whoop_alert_dialog_positive_action_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/whoop_alert_dialog_negative_action_layout"
        app:layout_constraintTop_toBottomOf="@+id/whoop_alert_dialog_body_header_text"
        app:strokedPillColor="@color/white"
        app:strokedPillStrokeColorOverride="@color/Whoop.Black"
        app:strokedPillUseStaticAlpha="false">
        <TextView
            android:textSize="@dimen/text_size_standard"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/whoop_alert_dialog_positive_action_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/action_yes"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"/>
    </com.whoop.p069ui.pills.StrokedPillFrameLayout>
    <com.whoop.p069ui.pills.StrokedPillFrameLayout
        android:id="@+id/whoop_alert_dialog_single_action_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="25dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/whoop_alert_dialog_body_header_text"
        app:strokedPillColor="@color/white"
        app:strokedPillStrokeColorOverride="@color/Whoop.Black"
        app:strokedPillUseStaticAlpha="false">
        <TextView
            android:textSize="@dimen/text_size_standard"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/whoop_alert_dialog_single_action_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/okay"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"/>
    </com.whoop.p069ui.pills.StrokedPillFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
