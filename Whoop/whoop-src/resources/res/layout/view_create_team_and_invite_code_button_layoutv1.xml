<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_create_team_and_invite_code_button_layoutv1_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_slightly_small"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/button_create_team"
        android:background="@drawable/ic_dashed_rectangle"
        android:padding="@dimen/Margin.Half"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:minHeight="36dp"
        android:text="@string/create_a_team"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_bold"
        android:layout_marginEnd="5dp"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toStartOf="@+id/button_invite_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_slightly_small"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/button_invite_code"
        android:background="@drawable/ic_dashed_rectangle"
        android:padding="@dimen/Margin.Half"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:minHeight="36dp"
        android:text="@string/enter_invite_code"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_bold"
        android:layout_marginStart="5dp"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_create_team"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
