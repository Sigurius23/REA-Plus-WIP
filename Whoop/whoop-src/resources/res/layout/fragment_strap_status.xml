<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_strap_status_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/strap_settings_harvard_disconnected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.DoubleAndHalf"
        android:layout_marginBottom="@dimen/Margin.DoubleAndHalf"
        android:src="0x7f0806cc"
        android:scaleType="fitXY"
        android:contentDescription="@string/whoop_disconnected"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/whoop_disconnected_title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/whoop_disconnected"
        app:layout_constraintBottom_toBottomOf="@+id/strap_settings_harvard_disconnected"
        app:layout_constraintEnd_toEndOf="@+id/strap_settings_harvard_disconnected"
        app:layout_constraintStart_toStartOf="@+id/strap_settings_harvard_disconnected"
        app:layout_constraintTop_toTopOf="@+id/strap_settings_harvard_disconnected"
        app:layout_constraintVertical_bias="0.7"
        style="@style/Headline4"/>
    <TextView
        android:id="@+id/whoop_disconnected_subtitle_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:text="@string/select_pair_a_device"
        android:alpha="0.5"
        app:layout_constraintEnd_toEndOf="@+id/strap_settings_harvard_disconnected"
        app:layout_constraintStart_toStartOf="@+id/strap_settings_harvard_disconnected"
        app:layout_constraintTop_toBottomOf="@+id/whoop_disconnected_title_text_view"
        style="@style/Paragraph2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/disconnected_view_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="strap_settings_harvard_disconnected,whoop_disconnected_title_text_view, whoop_disconnected_subtitle_text_view"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/strap_settings_animation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="0dp"
        android:scaleType="fitStart"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.whoop.p069ui.views.NewStrapSettingsBatteryIndicator
        android:id="@+id/strap_settings_battery_level_indicator"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="100dp"
        android:layoutDirection="ltr"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/strap_settings_animation"
        app:layout_constraintBottom_toTopOf="@+id/bottom_layout_container"
        app:layout_constraintEnd_toEndOf="@+id/strap_settings_animation"
        app:layout_constraintTop_toTopOf="@+id/strap_settings_animation"
        app:layout_constraintVertical_bias="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_layout_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/Margin.Standard"
        android:layout_marginRight="@dimen/Margin.Standard"
        android:layout_marginBottom="@dimen/Margin.Standard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hr_broadcast_container"
            android:background="@drawable/bg_settings_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.15"/>
            <ImageView
                android:id="@+id/strap_settings_hr_broadcast_static_image"
                android:visibility="visible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_hr_broadcast_off"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/strap_settings_hr_broadcast_animation"
                android:layout_width="58dp"
                android:layout_height="60dp"
                android:src="@raw/hr_broadcast_pulse"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/strap_settings_hr_broadcast_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Double"
                android:text="@string/hr_broadcast_title"
                app:layout_constraintBottom_toTopOf="@+id/strap_settings_hr_broadcast_subtitle"
                app:layout_constraintEnd_toStartOf="@+id/strap_settings_hr_broadcast_switch"
                app:layout_constraintStart_toEndOf="@+id/guideline_15"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="@dimen/Margin.Double"
                style="@style/Headline4"/>
            <TextView
                android:textColor="@color/white_50"
                android:id="@+id/strap_settings_hr_broadcast_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/hr_broadcast_subtitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/strap_settings_hr_broadcast_title"
                app:layout_constraintStart_toStartOf="@+id/strap_settings_hr_broadcast_title"
                app:layout_constraintTop_toBottomOf="@+id/strap_settings_hr_broadcast_title"
                style="@style/Headline6"/>
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/NewStrapSetingsSwitch"
                android:id="@+id/strap_settings_hr_broadcast_switch"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/strap_settings_hr_broadcast_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/strap_settings_hr_broadcast_title"
                app:switchTextAppearance="@style/NewStrapSetingsSwitchTextAppearance"
                app:track="@drawable/switch_track_new_strap_settings"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pair_whoop_strap_layout"
                android:background="@drawable/bg_settings_item"
                android:paddingBottom="@dimen/divider_thickness"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/Margin.Standard"
                android:layout_marginBottom="@dimen/Margin.Standard"
                android:layout_marginStart="@dimen/Margin.Standard"
                android:layout_marginEnd="@dimen/Margin.Standard">
                <ImageView
                    android:id="@+id/pair_strap_image_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/Margin.DoubleAndHalf"
                    android:layout_marginRight="@dimen/Margin.DoubleAndHalf"
                    android:src="@drawable/ic_pair_strap"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/pair_whoop_strap_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pair_a_device"
                    android:layout_marginStart="@dimen/Margin.DoubleAndHalf"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/pair_strap_image_view"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Headline4"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
