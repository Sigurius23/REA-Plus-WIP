<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/transparent"
    android:paddingLeft="@dimen/Margin.Double"
    android:paddingRight="@dimen/Margin.Double"
    android:fitsSystemWindows="true"
    android:layout_width="wrap_content"
    android:layout_height="?attr/actionBarSize"
    android:layout_marginTop="@dimen/Margin.Standard"
    android:minWidth="48dp"
    android:layout_marginStart="@dimen/Margin.Double"
    style="@style/WhoopActionBar">
    <ImageView
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_selectable_item_background_borderless"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@string/action_back"/>
</FrameLayout>
