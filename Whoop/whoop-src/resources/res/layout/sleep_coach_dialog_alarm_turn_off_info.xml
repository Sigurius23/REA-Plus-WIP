<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alarm_turn_off_dialog"
    android:background="@drawable/bg_sleep_coach_dialog_rounded"
    android:paddingBottom="@dimen/Margin.Sextuple"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/turn_off_alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_coach_alarm_turn_off_alarm"
        android:contentDescription="@string/sleep_coach_action_close"
        android:layout_marginVertical="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Headline3"/>
    <ImageView
        android:id="@+id/close_icon"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/sleep_coach_action_close"
        app:layout_constraintBottom_toBottomOf="@+id/turn_off_alarm_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintStart_toEndOf="@+id/turn_off_alarm_title"
        app:layout_constraintTop_toTopOf="@+id/turn_off_alarm_title"/>
    <ImageView
        android:id="@+id/turn_off_alarm_strap_icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="0x7f0805bc"
        android:contentDescription="@string/sleep_coach_action_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/turn_off_alarm_title"/>
    <TextView
        android:textColor="@color/white_50"
        android:id="@+id/turn_off_alarm_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/sleep_coach_alarm_turn_off_alarm_description"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/turn_off_alarm_strap_icon"
        style="@style/Paragraph2"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textSize="13sp"
        android:id="@+id/alarm_turn_off_got_it"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/sleep_coach_action_got_it"
        android:fontFamily="@font/alphabetic_font_bold"
        android:layout_marginStart="@dimen/sleep_coach_modal_button_margins"
        android:layout_marginEnd="@dimen/sleep_coach_modal_button_margins"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/turn_off_alarm_description"
        app:strokedPillColor="@android:color/transparent"
        app:strokedPillNormalAlpha="0"
        app:strokedPillStrokeColor="@color/Whoop.White"
        app:strokedPillStrokeWidth="2dp"
        app:strokedPillUseStaticAlpha="false"
        style="@style/Button.StrokedPill"/>
</androidx.constraintlayout.widget.ConstraintLayout>
