<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_optimal_sleep_calculation"
    android:paddingBottom="36dp"
    android:layout_width="345dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:id="@+id/how_optimal"
        android:layout_marginTop="36dp"
        android:text="@string/sleep_coach_how_optimal_sleep_is_calculated"
        android:layout_alignParentTop="true"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_bold"
        android:layout_marginStart="30dp"
        android:layout_alignParentStart="true"
        app:layout_constraintEnd_toStartOf="@+id/optimal_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Headline4"/>
    <ImageView
        android:id="@+id/optimal_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:src="@drawable/ic_close_black"
        android:contentDescription="@string/sleep_coach_action_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#969696"
        android:id="@+id/recommended_explanation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/sleep_coach_recommended_time_explanation"
        android:fontFamily="@font/alphabetic_font_semibold"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/how_optimal"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/learn_more_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_coach_help_center_learn_more"
        android:fontFamily="@font/alphabetic_font_semibold"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommended_explanation"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recommended_time_background"
        android:background="@drawable/bg_optimal_sleep_calculation_green"
        android:layout_width="283dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/learn_more_label">
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/sleep_need_label"
            android:layout_marginTop="15dp"
            android:text="@string/sleep_coach_sleep_need"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Headline4"/>
        <com.whoop.coaching.sleepcoach.harvard.view.DashedLineView
            android:background="@drawable/shape_dashed_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:alpha="0.5"
            android:layout_marginHorizontal="9dp"
            app:dashedLineColor="@color/black_50"
            app:dashedLineGap="2dp"
            app:dashedLineWidth="5dp"
            app:layout_constraintBottom_toTopOf="@+id/baseline_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleep_need_label"/>
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/baseline_label"
            android:layout_marginTop="15dp"
            android:text="@string/sleep_coach_baseline"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleep_need_label"
            style="@style/Headline4"/>
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/recent_strain_label"
            android:layout_marginTop="15dp"
            android:text="@string/sleep_coach_recent_strain"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/baseline_label"
            style="@style/Headline4"/>
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/sleep_debt_label"
            android:layout_marginTop="12dp"
            android:text="@string/sleep_coach_sleep_debt"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recent_strain_label"
            style="@style/Headline4"/>
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/recent_naps_label"
            android:layout_marginTop="15dp"
            android:text="@string/sleep_coach_recent_naps"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleep_debt_label"
            style="@style/Headline4"/>
        <com.whoop.coaching.sleepcoach.harvard.view.DashedLineView
            android:background="@drawable/shape_dashed_line"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/shape_dashed_line"
            android:layout_marginHorizontal="9dp"
            app:dashedLineColor="@color/black"
            app:dashedLineGap="0dp"
            app:layout_constraintBottom_toTopOf="@+id/recommended_time_in_bed_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/average_awake_time_label"/>
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/sleep_goal_label"
            android:layout_marginTop="27dp"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recent_naps_label"
            style="@style/Headline4"/>
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/average_awake_time_label"
            android:layout_marginTop="19dp"
            android:text="@string/sleep_coach_average_awake_time"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleep_goal_label"
            style="@style/Headline4"/>
        <com.whoop.coaching.sleepcoach.harvard.view.DashedLineView
            android:id="@+id/survey_date_divider_line"
            android:background="@drawable/shape_dashed_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:alpha="0.5"
            android:layout_marginHorizontal="9dp"
            app:dashedLineColor="@color/black_50"
            app:dashedLineGap="2dp"
            app:dashedLineWidth="5dp"
            app:layout_constraintBottom_toTopOf="@+id/sleep_goal_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recent_naps_label"/>
        <TextView
            android:textSize="@dimen/sleep_coach_text_size_11_sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/recommended_time_in_bed_label"
            android:paddingBottom="21dp"
            android:layout_marginTop="33dp"
            android:text="@string/sleep_coach_recommended_time_in_bed"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/average_awake_time_label"
            style="@style/Headline4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/sleep_need_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/sleep_need_label"
            style="@style/TextStyle.H4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/baseline_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/baseline_label"
            style="@style/TextStyle.H4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/recent_strain_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/baseline_value"
            style="@style/TextStyle.H4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/sleep_debt_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/sleep_debt_label"
            style="@style/TextStyle.H4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/recent_naps_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/recent_naps_label"
            style="@style/TextStyle.H4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/sleep_goal_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/sleep_goal_label"
            style="@style/TextStyle.H4"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/average_awake_time_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/average_awake_time_label"
            style="@style/TextStyle.H4"/>
        <TextView
            android:textSize="25sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/recommended_time_in_bed_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="17dp"
            android:textAllCaps="true"
            android:fontFamily="@font/dinpro_bold"
            android:layout_marginEnd="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/average_awake_time_value"
            style="@style/TextStyle.H4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
