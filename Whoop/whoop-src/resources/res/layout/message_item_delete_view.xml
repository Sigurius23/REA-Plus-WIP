<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/message_item_delete_view_0"
    android:background="@drawable/bg_message_delete_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/Margin.StandardAndHalf"
    android:layout_marginBottom="@dimen/Margin.StandardAndHalf"
    android:paddingStart="@dimen/Margin.Half"
    android:paddingEnd="@dimen/Margin.Half"
    android:layout_marginStart="@dimen/Margin.Quintuple">
    <TextView
        android:textStyle="italic"
        android:textColor="@color/delete_message_color"
        android:id="@+id/deleteLabel"
        android:padding="@dimen/Margin.Standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/community_message_deleted"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
