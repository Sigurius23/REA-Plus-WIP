<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_member_level_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:minWidth="108dp">
    <ImageView
        android:id="@+id/level_badge"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@drawable/ic_unlocked_true"
        android:scaleType="centerCrop"
        android:contentDescription="@string/acc_member_level_profile_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white_30"
        android:gravity="center"
        android:id="@+id/tier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/alphabetic_font_semibold"
        android:breakStrategy="simple"
        app:layout_constraintEnd_toEndOf="@+id/level_badge"
        app:layout_constraintStart_toStartOf="@+id/level_badge"
        app:layout_constraintTop_toBottomOf="@+id/level_badge"
        style="@style/Headline6"/>
    <TextView
        android:id="@+id/level"
        android:layout_width="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/level_badge"
        app:layout_constraintStart_toStartOf="@+id/level_badge"
        app:layout_constraintTop_toBottomOf="@+id/tier"
        style="@style/Headline4"/>
    <TextView
        android:textColor="@color/white_50"
        android:gravity="center"
        android:id="@+id/level_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:breakStrategy="simple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/level"
        style="@style/Paragraph3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
