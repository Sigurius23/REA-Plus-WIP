<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ble_choose_strap_0"
    android:background="@drawable/bg_black_gradient_inverted"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/strap_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        android:layout_marginEnd="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_loop="true"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/back_iv"
        android:background="@drawable/bg_selectable_item_background_borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/design_ic_navigation_backward"
        android:contentDescription="@string/action_back"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/footer_fade"
        android:background="@drawable/connect_strap_footer_fade"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <include
        android:id="@+id/enable_location_services_container"
        android:visibility="gone"
        layout="@layout/view_enable_location_services"/>
    <include
        android:id="@+id/enable_bluetooth_container"
        android:visibility="gone"
        layout="@layout/view_enable_bluetooth_services"/>
    <include
        android:id="@+id/allow_location_permissions_container"
        android:visibility="gone"
        layout="@layout/view_allow_location_permissions"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/half_screen_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.55"/>
    <include
        android:id="@+id/choose_gen4_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        layout="@layout/view_choose_gen4_bluetooth_device"/>
</androidx.constraintlayout.widget.ConstraintLayout>
