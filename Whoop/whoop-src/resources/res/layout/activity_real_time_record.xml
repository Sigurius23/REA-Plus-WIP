<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_realTimeRecord_root"
    android:background="@color/Whoop.Background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/activity_realTimeRecord_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/toolbar_container"
            android:background="?attr/realTime_primaryColor"
            android:layout_width="match_parent"
            android:layout_height="96dp">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/activity_realTimeRecord_toolbar"
                android:background="?attr/realTime_primaryColor"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/Margin.Standard">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/activity_realTimeRecord_discard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <com.whoop.p069ui.views.ColoredImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_real_time_resume"
                        app:coloredImageViewColorFilter="@color/Whoop.White"/>
                    <TextView
                        android:textAppearance="@style/Whoop.Text.H2.White"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Activity.RealTime.Resume"
                        android:textAllCaps="true"
                        android:layout_marginStart="@dimen/Margin.StandardAndHalf"/>
                </LinearLayout>
                <View
                    android:background="@color/Whoop.Black"
                    android:layout_width="@dimen/divider_thickness"
                    android:layout_height="match_parent"
                    android:alpha="0.1"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/activity_realTimeRecording_save"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <com.whoop.p069ui.views.ColoredImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_finish"
                        app:coloredImageViewColorFilter="@color/Whoop.White"/>
                    <TextView
                        android:textAppearance="@style/Whoop.Text.H2.White"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Activity.RealTime.Finish"
                        android:textAllCaps="true"
                        android:layout_marginStart="@dimen/Margin.StandardAndHalf"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/activity_realTimeRecord_timerContainer"
                android:background="?attr/realTime_primaryColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.whoop.p069ui.views.ColoredImageView
                    android:layout_gravity="center"
                    android:id="@+id/activity_realTimeRecord_activityIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_real_time_pause"
                    android:layout_marginEnd="@dimen/Margin.Half"
                    app:coloredImageViewColorFilter="@color/Whoop.White"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/Margin.Standard">
                    <TextView
                        android:textSize="@dimen/text_size_slightly_huge"
                        android:textColor="@color/Whoop.White"
                        android:id="@+id/activity_realTimeRecord_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dinpro_medium"
                        style="@style/Text.Default"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <com.whoop.realtime.presentation.views.SlidingTabIndicator
            android:id="@+id/activity_realTimeRecord_tabStrip"
            android:background="@color/RealTimeStrainBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="25dp"
            app:slidingTabIndicatorBarColor="@color/Whoop.White"
            app:slidingTabIndicatorTabResource="@layout/tab_layout"
            app:slidingTabIndicatorTabTextId="@+id/tab_layout_tab"/>
        <com.whoop.realtime.presentation.adapter.WhoopViewPager
            android:id="@+id/activity_realTimeRecord_viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:textSize="160dp"
        android:textColor="@color/Whoop.White"
        android:gravity="center"
        android:id="@+id/activity_realTimeRecord_workoutCountdown"
        android:background="?attr/realTime_primaryColor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/dinpro_medium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/activity_realTimeRecord_sleepSplash"
        android:background="?attr/realTime_primaryColor"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="2"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/activity_realTimeRecord_sleepSplashContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.whoop.p069ui.views.ColoredImageView
                android:id="@+id/activity_realTimeRecord_sleepIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="?attr/realTime_heartRateIcon"
                android:tint="@color/Whoop.White"/>
            <TextView
                android:textSize="26dp"
                android:textColor="@color/Whoop.White"
                android:id="@+id/activity_realTimeRecord_sleepSplashText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Double"
                android:text="?attr/realTime_startMessage"
                android:fontFamily="@font/alphabetic_font_bold"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="4"/>
    </LinearLayout>
</FrameLayout>
