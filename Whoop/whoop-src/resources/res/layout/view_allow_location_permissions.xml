<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/view_allow_location_permissions_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_location_permission"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"/>
        <TextView
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Standard"
            android:text="@string/allow_location_permissions"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/StrapSettingsTitleStyle"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Standard"
            android:text="@string/allow_location_permissions_text"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/StrapSettingsMessageStyle"/>
        <com.whoop.p069ui.pills.StrokedPillButton
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/allow_location_permissions_button_new"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/allow_location_permissions"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="35dp"
            android:letterSpacing="0.1"
            app:strokedPillColor="@color/white"
            app:strokedPillNormalAlpha="0"
            app:strokedPillUseStaticAlpha="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
