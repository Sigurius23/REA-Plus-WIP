<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optionsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/stream_ui_white_snow"
    app:cardCornerRadius="@dimen/stream_ui_options_menu_corner_radius">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/stream_ui_divider"
        android:showDividers="middle">
        <TextView
            android:id="@+id/reply"
            android:text="@string/stream_ui_attachment_gallery_reply"
            android:textDirection="locale"
            style="@style/StreamUiMessageOptionItem"/>
        <TextView
            android:id="@+id/showInChat"
            android:text="@string/stream_ui_attachment_gallery_show_in_chat"
            android:textDirection="locale"
            style="@style/StreamUiMessageOptionItem"/>
        <TextView
            android:id="@+id/saveMedia"
            android:text="@string/stream_ui_attachment_gallery_save_media"
            android:textDirection="locale"
            style="@style/StreamUiMessageOptionItem"/>
        <TextView
            android:id="@+id/delete"
            android:text="@string/stream_ui_attachment_gallery_delete"
            android:textDirection="locale"
            style="@style/StreamUiMessageOptionItem"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
