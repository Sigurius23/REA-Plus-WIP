<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_real_time_heartrate_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.whoop.p069ui.views.RealTimeHeartGraph
        android:id="@+id/heartGraph"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gradientScale="0.6"/>
    <com.whoop.p069ui.views.LiveHeartRateView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/heartRateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        app:liveHeartRateColorForSleep="?attr/realTime_isSleep"
        app:liveHeartRateColorForWorkout="?attr/realTime_isWorkout"
        app:liveHeartRateHideValues="?attr/realTime_hideValues"
        app:liveHeartRateIcon="?attr/realTime_heartRateIcon"
        app:liveHeartRateShowBattery="false"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/whoopLiveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/Margin.Double"
        android:src="@drawable/ic_camera_circled_w"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/activity_realTimeRecord_sharedBottomCells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0x7f07000e"
        android:layout_marginBottom="0x7f07000e"
        android:paddingStart="@dimen/Margin.Double"
        android:paddingEnd="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Standard"
        android:layout_marginEnd="@dimen/Margin.Standard">
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/avgHrCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:realTimeCellIcon="@drawable/ic_hr"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/Activity.RealTime.Cell.AvgHr"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
        <View
            android:id="@+id/activity_realTimeRecord_sharedDiv1"
            android:background="@color/Whoop.White.MostlyTransparent"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/Margin.Double"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/strainCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/Margin.Double"
            app:realTimeCellIcon="@drawable/ic_activity_strain"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/Activity.RealTime.Cell.ActivityStrain"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
        <View
            android:id="@+id/activity_realTimeRecord_sharedDiv2"
            android:background="@color/Whoop.White.MostlyTransparent"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/Margin.Double"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/calorieCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:realTimeCellIcon="@drawable/ic_calories"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/Activity.RealTime.Cell.Calories"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
    </LinearLayout>
</FrameLayout>
