<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_community_pending_0"
    android:background="@drawable/main_background_gradient_color"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/community_landing_pending_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/fragment_community_landing_toolbar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/community_pending_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/community_landing_pending_toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
