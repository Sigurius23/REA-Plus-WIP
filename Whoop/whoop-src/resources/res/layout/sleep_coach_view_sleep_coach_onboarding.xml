<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/onboarding_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/bg_sleep_coach_onboarding_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/onboarding_background"
        app:layout_constraintEnd_toEndOf="@+id/onboarding_background"
        app:layout_constraintStart_toStartOf="@+id/onboarding_background"
        app:layout_constraintTop_toTopOf="@+id/onboarding_background"/>
    <ImageView
        android:id="@+id/close_onboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/sleep_coach_action_back"
        app:layout_constraintStart_toEndOf="@+id/guideline_10_vertical"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/onboarding_screen_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toTopOf="@+id/onboarding_screen_descreption_one"
        app:layout_constraintEnd_toEndOf="@+id/guideline_90_vertical"
        app:layout_constraintStart_toStartOf="@+id/guideline_10_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.92"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TextStyle.H1"/>
    <TextView
        android:textColor="@color/white_50"
        android:gravity="start"
        android:id="@+id/onboarding_screen_descreption_one"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/onboarding_screen_descreption_two"
        app:layout_constraintEnd_toEndOf="@+id/guideline_90_vertical"
        app:layout_constraintStart_toStartOf="@+id/guideline_10_vertical"
        app:layout_constraintTop_toBottomOf="@+id/onboarding_screen_title"
        style="@style/Paragraph2"/>
    <TextView
        android:textColor="@color/white_50"
        android:gravity="start"
        android:id="@+id/onboarding_screen_descreption_two"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_90"
        app:layout_constraintEnd_toEndOf="@+id/guideline_90_vertical"
        app:layout_constraintStart_toStartOf="@+id/guideline_10_vertical"
        app:layout_constraintTop_toBottomOf="@+id/onboarding_screen_descreption_one"
        style="@style/Paragraph2"/>
    <TextView
        android:gravity="center"
        android:id="@+id/next_screen"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="5dp"
        app:drawableEndCompat="@drawable/ic_arrow_forward_white"
        app:layout_constraintEnd_toEndOf="@+id/guideline_90_vertical"
        app:layout_constraintTop_toBottomOf="@+id/guideline_90"
        style="@style/TextStyle.H5"/>
    <TextView
        android:gravity="center"
        android:id="@+id/back_screen"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_coach_action_back"
        android:drawablePadding="5dp"
        app:drawableStartCompat="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="@+id/guideline_10_vertical"
        app:layout_constraintTop_toBottomOf="@+id/guideline_90"
        style="@style/TextStyle.H5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_90"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_90_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_10_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
