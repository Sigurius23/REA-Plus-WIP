<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/community_landing_feature_team_layout"
    android:layout_width="160dp"
    android:layout_height="191dp"
    android:layout_margin="@dimen/Margin.Standard"
    app:cardBackgroundColor="@color/transparent_color"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp">
    <ImageView
        android:id="@+id/community_landing_feature_team_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/ic_gradient"
        android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="@color/transparent_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/feature_team_new_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_feature_team_new"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11sp"
            android:id="@+id/feature_team_new_banner_text"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/community_ama_new"
            android:lines="1"
            android:rotation="-45"
            android:textAllCaps="true"
            android:layout_marginStart="1dp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeMinTextSize="6sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Paragraph1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/community_landing_feature_team_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:foreground="@drawable/team_avatar_background"
                android:src="@drawable/ic_user_avatar_default"
                android:cropToPadding="true"
                android:layout_centerInParent="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_user_avatar_default"/>
            <TextView
                android:textSize="@dimen/text_size_standard"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/community_landing_feature_team_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Standard"
                android:text="@string/community_feature_team_name_placeholder"
                android:maxLines="2"
                android:textAllCaps="true"
                android:fontFamily="@font/alphabetic_font_bold"
                android:paddingStart="@dimen/Margin.Standard"
                android:paddingEnd="@dimen/Margin.Standard"
                android:letterSpacing="0.05"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/community_landing_feature_team_icon"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/Whoop.White.HalfTransparent"
                android:id="@+id/community_landing_feature_team_member_count"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Standard"
                android:text="@string/community_feature_team_count_placeholder"
                android:textAllCaps="true"
                android:fontFamily="@font/alphabetic_font_bold"
                android:letterSpacing="0.05"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/community_landing_feature_team_name"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
