<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/community_landing_rank_layout"
    android:tag="layout/community_landing_rank_settings_0"
    android:background="@drawable/bg_rounded_corner_sheet"
    android:clickable="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <ImageView
        android:id="@+id/community_landing_rank_handler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Double"
        android:src="@drawable/ic_sheet_handle"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_11"
        android:textColor="@color/calendar_text_color"
        android:id="@+id/community_landing_rank_display_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:text="@string/community_display_rank_as"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_bold"
        app:layout_constraintStart_toEndOf="@+id/guideline_five"
        app:layout_constraintTop_toBottomOf="@+id/community_landing_rank_handler"/>
    <com.whoop.community.presentation.p059ui.PillRadioGroup
        android:id="@+id/community_landing_ranks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:minHeight="@dimen/selector_height"
        app:layout_constraintEnd_toEndOf="@+id/guideline_ninety_five"
        app:layout_constraintStart_toEndOf="@+id/guideline_five"
        app:layout_constraintTop_toBottomOf="@+id/community_landing_rank_display_label"
        app:outlineColor="@color/teams_black_opaque"
        app:selectorColor="@color/black"
        app:values="@array/Community.Pillars"/>
    <TextView
        android:textSize="@dimen/text_size_11"
        android:textColor="@color/calendar_text_color"
        android:id="@+id/community_landing_rank_period_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:text="@string/community_over_course_label"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_bold"
        app:layout_constraintStart_toEndOf="@+id/guideline_five"
        app:layout_constraintTop_toBottomOf="@+id/community_landing_ranks"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/rank_period_radio"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        app:layout_constraintStart_toEndOf="@+id/guideline_five"
        app:layout_constraintTop_toBottomOf="@+id/community_landing_rank_period_label">
        <RadioButton
            android:textSize="@dimen/text_size_11"
            android:textColor="@color/black"
            android:id="@+id/rank_period_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Half"
            android:checked="true"
            android:text="@string/Today"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:buttonTint="@color/black"
            style="@style/Community.Rank"/>
        <RadioButton
            android:textSize="@dimen/text_size_11"
            android:textColor="@color/black"
            android:id="@+id/rank_period_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Half"
            android:text="@string/community_rank_week_placeholder"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:buttonTint="@color/black"
            style="@style/Community.Rank"/>
        <RadioButton
            android:textSize="@dimen/text_size_11"
            android:textColor="@color/black"
            android:id="@+id/rank_period_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Half"
            android:text="@string/community_rank_month_placeholder"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:buttonTint="@color/black"
            style="@style/Community.Rank"/>
    </RadioGroup>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textColor="@color/calendar_red_color"
        android:id="@+id/community_landing_rank_apply"
        android:paddingTop="@dimen/Margin.Standard"
        android:paddingBottom="@dimen/Margin.Standard"
        android:layout_width="0dp"
        android:layout_height="@dimen/Margin.Quintuple"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:layout_marginBottom="@dimen/Margin.Triple"
        android:text="@string/community_apply"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guideline_ninety_five"
        app:layout_constraintStart_toStartOf="@+id/guideline_five"
        app:layout_constraintTop_toBottomOf="@+id/rank_period_radio"
        app:strokedPillColor="@color/white"
        app:strokedPillNormalAlpha="1"
        app:strokedPillStrokeColor="@color/calendar_red_color"
        app:strokedPillStrokeWidth="2dp"
        app:strokedPillUseStaticAlpha="false"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_five"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_ninety_five"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"/>
</androidx.constraintlayout.widget.ConstraintLayout>
