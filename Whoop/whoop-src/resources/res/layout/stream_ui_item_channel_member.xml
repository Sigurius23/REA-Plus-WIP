<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:layout_width="@dimen/stream_ui_channel_actions_member_height"
    android:layout_height="match_parent">
    <io.getstream.chat.android.p226ui.widgets.avatar.UserAvatarView
        android:id="@+id/userAvatarView"
        style="?attr/streamUiChannelActionsDialogAvatarStyle"/>
    <TextView
        android:textAppearance="@style/StreamUiTextAppearance.FootnoteBold"
        android:textColor="@color/stream_ui_text_color_primary"
        android:id="@+id/userNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textDirection="locale"/>
</LinearLayout>
