<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/fragment_push_debug_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="120dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Button
            android:id="@+id/sendMciOverviewSilentPush"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MCI Overview Silent Push"/>
        <Button
            android:id="@+id/sendRefreshEntitlementsSilentPush"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh Entitlements Silent Push"/>
        <Button
            android:id="@+id/sendRefreshPendingFollowerInvites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh Pending Follower Invites (Badge) Silent Push"/>
        <Button
            android:id="@+id/sendDeadBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send Dead Battery push"/>
        <Button
            android:id="@+id/sendSleepNeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send Sleep Need push"/>
        <Button
            android:id="@+id/sendAdvancedLabsUploadSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advanced Labs Upload Success"/>
        <Button
            android:id="@+id/sendAdvancedLabsUploadFailure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advanced Labs Upload Failure"/>
        <Button
            android:id="@+id/sendStreakRestoreAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak Restore Available"/>
        <Button
            android:id="@+id/sendStreakRestorationReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak Restoration Reminder"/>
        <Button
            android:id="@+id/sendStreakRestoration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak Restoration"/>
        <Button
            android:id="@+id/sendGpsInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS Insights"/>
        <Button
            android:id="@+id/sendCoachEverywhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coach Everywhere"/>
        <Button
            android:id="@+id/sendChatWithAgent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat With Agent"/>
        <Button
            android:id="@+id/sendWhoopLabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Whoop Labs"/>
        <Button
            android:id="@+id/sendWhoopLabsToCampaign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Whoop Labs to campaign 149"/>
        <Button
            android:id="@+id/sendWhoopLabsToSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Whoop Labs to session 37"/>
        <Button
            android:id="@+id/sendArchV2GenericCitlHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arch V2 Generic — CITL Home (arch v2)"/>
        <Button
            android:id="@+id/sendArchV2GenericCitlIntake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arch V2 Generic — CITL Intake (arch v1)"/>
        <Button
            android:id="@+id/sendArchV2GenericDistinctIds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arch V2 Generic — distinct ids (stack)"/>
        <Button
            android:id="@+id/sendArchV2GenericReplaceInPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arch V2 Generic — replace in place"/>
        <Button
            android:id="@+id/sendArchV2GenericChannelB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arch V2 Generic — Channel B"/>
        <Button
            android:id="@+id/sendArchV2GenericMalformedDeeplink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arch V2 Generic — malformed deeplink"/>
        <Button
            android:id="@+id/sendFollowerInvite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community — Follower Invite"/>
        <Button
            android:id="@+id/sendFollowerInviteAccepted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community — Follower Invite Accepted"/>
        <Button
            android:id="@+id/sendInviteToJoinCommunity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community — Invite To Join Community"/>
    </LinearLayout>
</ScrollView>
