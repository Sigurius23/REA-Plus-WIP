<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_team_pick_image_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image_swipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_swipe_leftright"
        android:contentDescription="@string/community_acc_swipe_left_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/swipe_text"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0x7f07000e"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_swipe"
        style="@style/Teams.SectionLabel"/>
    <TextView
        android:textColor="@color/Whoop.Gray"
        android:id="@+id/or_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Double"
        android:text="@string/community_or"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swipe_text"
        style="@style/Teams.SectionLabel"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textAppearance="@style/Whoop.Text.H1.White"
        android:textColor="@color/Whoop.White"
        android:id="@+id/image_upload"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/Margin.Double"
        android:text="@string/upload_a_photo"
        android:layout_marginHorizontal="0x7f07000e"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/or_text"
        app:strokedPillColor="@color/Whoop.Black"
        app:strokedPillNormalAlpha="1"
        app:strokedPillStrokeColor="@color/Whoop.White"
        app:strokedPillUseStaticAlpha="false"
        style="@style/Button.Flat"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textAppearance="@style/Whoop.Text.H1.White"
        android:textColor="@color/Whoop.Red"
        android:id="@+id/select_image_ok"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:text="@string/community_action_save"
        android:layout_marginHorizontal="0x7f07000e"
        app:layout_constraintTop_toBottomOf="@+id/image_upload"
        app:strokedPillColor="@color/Whoop.Black"
        app:strokedPillNormalAlpha="1"
        app:strokedPillStrokeColor="@color/Whoop.Red"
        app:strokedPillUseStaticAlpha="false"
        style="@style/Button.Flat"/>
</androidx.constraintlayout.widget.ConstraintLayout>
