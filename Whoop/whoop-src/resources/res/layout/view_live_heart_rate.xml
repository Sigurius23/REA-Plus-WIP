<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/view_liveHeartRate_circle"
        android:background="@drawable/bg_live_heart_rate_workout"
        android:paddingTop="@dimen/Margin.Double"
        android:paddingBottom="@dimen/Margin.Double"
        android:layout_width="130dp"
        android:layout_height="130dp">
        <com.whoop.p069ui.views.ColoredImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/view_liveHeartRate_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:src="@drawable/ic_hr"
            android:adjustViewBounds="true"
            app:coloredImageViewColorFilter="@color/Whoop.White"/>
        <ViewFlipper
            android:id="@+id/view_liveHeartRate_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/view_liveHeartRate_largeIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="0x7f07000e"
                android:layout_marginTop="0x7f07000e"
                android:layout_marginRight="0x7f07000e"
                android:layout_marginBottom="@dimen/Margin.Triple"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/view_liveHeartRate_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textAppearance="@style/Whoop.Text.H2.White"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:id="@+id/view_liveHeartRate_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="@string/StrapStatus.Label.Calibrating"
                    android:lines="1"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:layout_marginStart="@dimen/Margin.Standard"
                    android:layout_marginEnd="@dimen/Margin.Standard"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeTextType="uniform"/>
                <com.whoop.p069ui.views.ColoredImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/view_liveHeartRate_bluetoothIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_ticker_status_bluetooth"
                    android:alpha="@dimen/StrapStatus.BottomAlpha"
                    app:coloredImageViewColorFilter="@color/StrapStatus.SecondaryColor.Dark"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/view_liveHeartRate_values"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/view_liveHeartRate_heartRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/HearRate_Text"/>
                <TextView
                    android:textColor="@color/white_50"
                    android:gravity="center"
                    android:id="@+id/view_liveHeartRate_bpm"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bpm"
                    android:textAllCaps="true"
                    style="@style/BPM_Text"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/view_liveHeartRate_batteryContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/Margin.Standard">
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingEnd="@dimen/Margin.Quarter">
                            <LinearLayout
                                android:gravity="end"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="13dp"
                                android:alpha="@dimen/StrapStatus.BottomAlpha">
                                <com.whoop.p069ui.views.ColoredImageView
                                    android:id="@+id/view_liveHeartRate_batteryCharging"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_charging"
                                    app:coloredImageViewColorFilter="@color/Whoop.White"/>
                                <com.whoop.p069ui.old.Battery
                                    android:layout_gravity="end"
                                    android:id="@+id/view_liveHeartRate_battery"
                                    android:layout_width="24dp"
                                    android:layout_height="match_parent"
                                    app:batteryColorBad="@color/Whoop.White"
                                    app:batteryColorGood="@color/Whoop.White"
                                    app:batteryOutlineColor="@color/Whoop.White"/>
                            </LinearLayout>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="@dimen/Margin.Quarter">
                            <TextView
                                android:textSize="@dimen/text_size_standard"
                                android:textColor="@color/Whoop.White"
                                android:layout_gravity="start"
                                android:id="@+id/view_liveHeartRate_batteryPercent"
                                android:paddingBottom="2dp"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:alpha="0.4"
                                android:fontFamily="@font/dinpro_medium"
                                style="@style/Text"/>
                        </FrameLayout>
                    </LinearLayout>
                    <TextView
                        android:textAppearance="@style/Whoop.Text.MediumNumber"
                        android:textSize="@dimen/text_size_standard"
                        android:textColor="@color/Whoop.White.HalfTransparent"
                        android:layout_gravity="center"
                        android:id="@+id/view_liveHeartRate_zone"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>
</merge>
