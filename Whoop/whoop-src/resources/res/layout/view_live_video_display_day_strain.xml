<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="14dp"
    android:layout_centerInParent="true">
    <RelativeLayout
        android:layout_width="68dp"
        android:layout_height="68dp">
        <com.whoop.p069ui.ProgressDial
            android:id="@+id/strainDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:progressDialGapLength="0"
            app:progressDialThickness="4dp"/>
        <TextView
            android:textAppearance="@style/Whoop.Text.MediumSmallNumber"
            android:textSize="20sp"
            android:textColor="@color/AthleteBio.Text"
            android:id="@+id/strainText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whooplive_place_holder_number"
            android:layout_centerInParent="true"
            android:fontFamily="@font/dinpro_bold"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/strainTitle"
        android:text="@string/whooplive_Strain.SnapPlus.DayStrain"
        style="@style/Display_Box_Text"/>
</LinearLayout>
