<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_team_create_logo_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/chooserView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Sextuple"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_team_pick_logo"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/uploadView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="logoCrop,drag_and_zoom_view"/>
    <com.whoop.p069ui.WhoopZoomageView
        android:id="@+id/logoCrop"
        android:layout_width="196dp"
        android:layout_height="196dp"
        android:layout_marginTop="@dimen/Margin.Double"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chooserView"
        app:zoomage_circleMask="true"/>
    <include
        android:id="@+id/drag_and_zoom_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/logoCrop"
        layout="@layout/view_drag_and_zoom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
