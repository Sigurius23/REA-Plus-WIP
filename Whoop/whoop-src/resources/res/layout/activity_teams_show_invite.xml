<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_teams_show_invite_0"
    android:background="@color/Whoop.Black.SlightlyLight"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="false"
            android:layout_marginHorizontal="@dimen/Margin.Double"
            app:layoutManager="LinearLayoutManager"/>
        <include
            android:layout_gravity="top"
            android:id="@+id/parallaxHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_anchorGravity="top"
            layout="@layout/layout_teams_overview_header"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <RelativeLayout
        android:id="@+id/loadingLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.whoop.p069ui.ThrobberView
            android:layout_gravity="center"
            android:id="@+id/throbberView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/noNetworkLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <com.whoop.p069ui.views.ColoredImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="@dimen/Margin.Double"
                android:src="@drawable/ic_no_network"
                app:coloredImageViewColorFilter="@color/Whoop.White"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/Whoop.Gray"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/noNetworkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/Margin.Double"
                android:text="@string/community_teams_nonetwork"
                style="@style/Whoop.Text.MediumSmallNumber"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/joinDeclineButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.whoop.p069ui.pills.StrokedPillButton
            android:textAppearance="@style/Whoop.Text.H1.White"
            android:textColor="@color/Whoop.Red"
            android:id="@+id/joinButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/community_teams_join_team"
            android:layout_marginHorizontal="0x7f07000e"
            android:layout_marginVertical="@dimen/Margin.Half"
            app:strokedPillColor="@color/Whoop.Black"
            app:strokedPillNormalAlpha="1"
            app:strokedPillStrokeColor="@color/Whoop.Red"
            app:strokedPillUseStaticAlpha="false"
            style="@style/Button.Flat"/>
        <com.whoop.p069ui.pills.StrokedPillButton
            android:textAppearance="@style/Whoop.Text.H1.White"
            android:id="@+id/declineButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/action_decline"
            android:layout_marginHorizontal="0x7f07000e"
            android:layout_marginVertical="@dimen/Margin.Half"
            app:strokedPillColor="@color/Whoop.Black"
            app:strokedPillNormalAlpha="1"
            app:strokedPillStrokeColor="@color/Whoop.Gray.Dark"
            app:strokedPillUseStaticAlpha="false"
            style="@style/Button.Flat"/>
    </LinearLayout>
</LinearLayout>
