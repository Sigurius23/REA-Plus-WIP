<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@+id/inputModeHeaderContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stream_ui_message_composer_header_content_height"
        android:paddingHorizontal="@dimen/stream_ui_spacing_small">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/inputModeImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/stream_ui_ic_arrow_curve_left"/>
        <TextView
            android:textAppearance="@style/StreamUiTextAppearance.BodyBold"
            android:layout_gravity="center"
            android:id="@+id/inputModeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stream_ui_message_composer_mode_reply"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/dismissInputModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/stream_ui_ic_clear"/>
    </FrameLayout>
</merge>
