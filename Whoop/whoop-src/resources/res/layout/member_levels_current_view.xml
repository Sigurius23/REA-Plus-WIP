<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/member_levels_current_view_0"
    android:background="@color/Whoop.Background"
    android:paddingTop="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/Margin.Standard"
    android:paddingEnd="8dp">
    <ImageView
        android:id="@+id/current_level_badge"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:scaleType="centerCrop"
        android:contentDescription="@string/acc_member_level_profile_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white_30"
        android:id="@+id/current_tier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:fontFamily="@font/alphabetic_font_semibold"
        app:layout_constraintEnd_toEndOf="@+id/current_level_badge"
        app:layout_constraintStart_toStartOf="@+id/current_level_badge"
        app:layout_constraintTop_toBottomOf="@+id/current_level_badge"
        style="@style/Headline4"/>
    <TextView
        android:id="@+id/current_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/current_level_badge"
        app:layout_constraintStart_toStartOf="@+id/current_level_badge"
        app:layout_constraintTop_toBottomOf="@+id/current_tier"
        style="@style/Headline2"/>
    <ImageView
        android:id="@+id/current_level_mini_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_marginStart="0x7f07000e"
        android:layout_marginEnd="@dimen/Margin.Standard"
        app:layout_constraintBottom_toBottomOf="@+id/level_progress_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/level_progress_bar"/>
    <android.widget.ProgressBar
        android:id="@+id/level_progress_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/Margin.Standard"
        android:layout_marginTop="10dp"
        android:progressDrawable="@drawable/progress_bar"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/Margin.Standard"
        android:layout_marginEnd="@dimen/Margin.Standard"
        app:layout_constraintBottom_toTopOf="@+id/current_level_progress_text"
        app:layout_constraintEnd_toStartOf="@+id/next_level_mini_badge"
        app:layout_constraintStart_toEndOf="@+id/current_level_mini_badge"
        app:layout_constraintTop_toBottomOf="@+id/current_level"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"/>
    <include
        android:id="@+id/level_onboarding_segment_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="@dimen/Margin.Standard"
        android:layout_marginEnd="@dimen/Margin.Standard"
        app:layout_constraintBottom_toTopOf="@+id/current_level_progress_text"
        app:layout_constraintEnd_toStartOf="@+id/next_level_mini_badge"
        app:layout_constraintStart_toEndOf="@+id/current_level_mini_badge"
        app:layout_constraintTop_toBottomOf="@+id/current_level"
        layout="@layout/view_onboarding_segment_bar"/>
    <ImageView
        android:id="@+id/next_level_mini_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/Margin.Standard"
        android:layout_marginEnd="0x7f07000e"
        app:layout_constraintBottom_toBottomOf="@+id/level_progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/level_progress_bar"/>
    <TextView
        android:textColor="@color/white_50"
        android:gravity="center"
        android:id="@+id/current_level_progress_text"
        android:paddingTop="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/level_progress_bar"
        app:layout_constraintStart_toStartOf="@+id/level_progress_bar"
        app:layout_constraintTop_toBottomOf="@+id/level_progress_bar"
        style="@style/Paragraph3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
