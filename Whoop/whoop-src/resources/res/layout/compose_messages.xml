<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/compose_messages_0"
    android:background="@color/compose_message_color"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/upload_indicator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/Whoop.Blue"
        app:layout_constraintBottom_toTopOf="@+id/edit_message_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/edit_message_label"
        android:paddingTop="@dimen/Margin.StandardAndHalf"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_message"
        android:paddingStart="@dimen/Margin.StandardAndHalf"
        android:paddingEnd="@dimen/Margin.StandardAndHalf"
        app:layout_constraintBottom_toTopOf="@+id/compose_input_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upload_indicator"
        style="@style/Headline4"/>
    <ImageView
        android:id="@+id/edit_close"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_close"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:layout_constraintBottom_toBottomOf="@+id/edit_message_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/edit_message_label"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/compose_input_layout"
        android:background="@drawable/bg_compose_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.StandardAndHalf"
        android:layout_marginBottom="@dimen/Margin.Double"
        android:minHeight="@dimen/Margin.Sextuple"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_message_label">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/selected_attachments_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.StandardAndHalf"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_avatar"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/selected_media_attachments_recyclerView"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/Margin.Half"
                android:layout_marginEnd="@dimen/Margin.Half"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/selected_file_attachments_recyclerView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@color/transparent_color"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </FrameLayout>
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/Margin.Standard"
            android:layout_marginBottom="@dimen/Margin.Half"
            android:src="@drawable/ic_profile_avatar"
            android:layout_marginStart="@dimen/Margin.Standard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/message_compose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/selected_attachments_container"/>
        <EditText
            android:id="@+id/message_compose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Half"
            android:layout_marginBottom="@dimen/Margin.Half"
            android:textCursorDrawable="@drawable/ic_compose_message_cursor"
            android:layout_marginStart="@dimen/Margin.Standard"
            android:layout_marginEnd="@dimen/Margin.Standard"
            app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_avatar"
            app:layout_constraintTop_toTopOf="@+id/user_avatar"
            style="@style/ComposeEditTextAppearance"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
