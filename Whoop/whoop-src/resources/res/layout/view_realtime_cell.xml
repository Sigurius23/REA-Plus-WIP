<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.whoop.p069ui.views.ColoredImageView
        android:gravity="start"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/view_realtime_cell_icon"
        android:tag="layout/view_realtime_cell_0"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginBottom="@dimen/Margin.Standard"
        android:scaleType="fitStart"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/view_realtime_cell_label"
        android:tag="layout/view_realtime_cell_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/Margin.Half"
        android:lines="2"
        android:textAllCaps="true"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="7sp"
        app:autoSizeTextType="uniform"
        style="@style/Headline5"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/view_realtime_cell_value"
        android:tag="layout/view_realtime_cell_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        app:autoSizeMaxTextSize="25sp"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeTextType="uniform"
        style="@style/Number5"/>
</merge>
