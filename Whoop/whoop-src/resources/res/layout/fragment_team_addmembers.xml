<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_team_addmembers_0"
    android:background="@color/Whoop.White"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.whoop.p069ui.WhoopNewToolbar
        android:id="@+id/add_members_toolbar"
        android:background="@color/transparent_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:toolbarTitle="@string/community_add_members"
        app:toolbarTitleColor="@color/white"/>
    <FrameLayout
        android:id="@+id/add_members_search_bar"
        android:background="@drawable/bg_gray_bottomline"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintTop_toBottomOf="@+id/add_members_toolbar">
        <EditText
            android:textColor="@color/Whoop.Black"
            android:textColorHint="@color/Whoop.Gray"
            android:layout_gravity="center_vertical"
            android:id="@+id/searchInput"
            android:background="@drawable/bg_edittext_round_white"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:hint="@string/team_addmembers_search_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="@dimen/Margin.Double"
            android:layout_marginStart="@dimen/Margin.Double"
            android:layout_marginEnd="@dimen/Margin.Double"
            style="@style/Teams.Data"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/searchFocusIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/community_search_icon"
            android:layout_marginEnd="@dimen/Margin.Triple"
            app:tint="@color/Whoop.Black"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/searchClearIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/community_search_clear_icon"
            android:layout_marginEnd="@dimen/Margin.Triple"
            app:tint="@color/Whoop.Gray.Light"/>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/add_members_search_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="200dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/searchEmptyLayout_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Half"
                android:src="@drawable/img_arrow_upleft"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_semi_large"
                android:textColor="@color/Whoop.Gray.Dark"
                android:layout_gravity="center_horizontal"
                android:id="@+id/searchEmptyLayout_search_member_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="62dp"
                android:layout_marginBottom="@dimen/Margin.Standard"
                android:text="@string/team_search_members"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Teams.UserName"/>
            <TextView
                android:textColor="@color/Whoop.Gray"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/searchEmptyLayout_search_member_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/team_addmembers_bottom_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchEmptyLayout_search_member_text"
                style="@style/Teams.Data"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/searchEmptyLayout_or"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0x7f07000e"
                android:src="@drawable/divider_or"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchEmptyLayout_search_member_description"/>
            <TextView
                android:textSize="@dimen/text_size_semi_large"
                android:textColor="@color/Whoop.Gray.Dark"
                android:layout_gravity="center_horizontal"
                android:id="@+id/searchResultsEmptyLayout_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="62dp"
                android:layout_marginBottom="@dimen/Margin.Standard"
                android:text="@string/no_search_results"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchEmptyLayout_or"
                style="@style/Teams.UserName"/>
            <TextView
                android:textColor="@color/Whoop.Gray"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/searchResultsEmptyLayout_description"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_search_results_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchResultsEmptyLayout_title"
                style="@style/Teams.Data"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/searchResultsEmptyLayout_or"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0x7f07000e"
                android:src="@drawable/divider_or"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchResultsEmptyLayout_description"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/referAFriendLayout_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="0x7f07000e"
                android:src="@drawable/ic_refer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchResultsEmptyLayout_or"
                app:tint="@color/Whoop.Gray.Light"/>
            <TextView
                android:textSize="@dimen/text_size_semi_large"
                android:textColor="@color/Whoop.Gray.Dark"
                android:layout_gravity="center_horizontal"
                android:id="@+id/referAFriendLayout_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Standard"
                android:layout_marginBottom="@dimen/Margin.Standard"
                android:text="@string/team_refer_friend"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/referAFriendLayout_icon"
                style="@style/Teams.UserName"/>
            <TextView
                android:textColor="@color/Whoop.Gray"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/add_team_members_referral_reward_text"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dinpro_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/referAFriendLayout_title"/>
            <com.whoop.p069ui.pills.StrokedPillButton
                android:textAppearance="@style/Whoop.Text.H1.White"
                android:textColor="@color/Whoop.Red"
                android:id="@+id/inviteButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/Margin.Double"
                android:layout_marginBottom="@dimen/Margin.Double"
                android:text="@string/invite_a_friend"
                android:textAllCaps="true"
                android:layout_marginStart="0x7f07000e"
                android:layout_marginEnd="0x7f07000e"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/add_team_members_referral_reward_text"
                app:strokedPillColor="@color/Whoop.White"
                app:strokedPillNormalAlpha="1"
                app:strokedPillStrokeColor="@color/Whoop.Red"
                app:strokedPillUseStaticAlpha="false"
                style="@style/Button.Flat"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateLayoutChanges="false"
        android:layout_marginHorizontal="@dimen/Margin.Double"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/shareCodeLayout"
        app:layout_constraintTop_toBottomOf="@+id/add_members_search_bar"/>
    <FrameLayout
        android:id="@+id/shareCodeLayout"
        android:background="@drawable/bg_gray_topline"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/Whoop.Gray"
                android:layout_gravity="center_vertical"
                android:id="@+id/shareCodeLayout_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_team_code"
                android:layout_marginEnd="@dimen/Margin.Standard"
                app:layout_constraintEnd_toStartOf="@+id/shareCode"
                style="@style/Teams.UserName"/>
            <TextView
                android:textColor="@color/Whoop.Black"
                android:layout_gravity="center_vertical"
                android:id="@+id/shareCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Teams.UserName"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/shareHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_context_help"
                android:contentDescription="@string/community_share_help_icon"
                android:layout_marginStart="@dimen/Margin.Double"
                app:tint="@color/Whoop.Gray"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
