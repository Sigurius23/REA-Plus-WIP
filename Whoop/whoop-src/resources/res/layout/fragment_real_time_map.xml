<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_real_time_map_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/gpsMap"
        android:layout="@layout/layout_gps_map_fragment_activity"
        android:inflatedId="@+id/gpsMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/activity_realTimeRecord_sharedBottomCells"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/whoopLiveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/Margin.Double"
        android:src="@drawable/ic_camera_circled_w"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/activity_realTimeRecord_sharedBottomCells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0x7f07000e"
        android:layout_marginBottom="0x7f07000e"
        android:paddingStart="@dimen/Margin.Double"
        android:paddingEnd="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Standard"
        android:layout_marginEnd="@dimen/Margin.Standard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gpsMap">
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/fragment_realTimeMap_distanceCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:realTimeCellIcon="@drawable/ic_arrow_forward"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/distance"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
        <View
            android:id="@+id/activity_realTimeRecord_sharedDiv1"
            android:background="@color/Whoop.White.MostlyTransparent"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/Margin.Double"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/fragment_realTimeMap_paceCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:realTimeCellIcon="@drawable/ic_individual_athlete"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/pace"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
        <View
            android:id="@+id/activity_realTimeRecord_sharedDiv2"
            android:background="@color/Whoop.White.MostlyTransparent"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/Margin.Double"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/fragment_realTimeMap_durationCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:realTimeCellIcon="@drawable/ic_stopwatch"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/duration"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
