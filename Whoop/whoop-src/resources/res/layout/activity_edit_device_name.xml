<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_edit_device_name_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/edit_device_name_transparent_toolbar_space"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/edit_device_name_background_view"
        android:background="@drawable/bg_rounded_corner_sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_device_name_transparent_toolbar_space"/>
    <ProgressBar
        android:id="@+id/edit_device_name_progress_bar"
        android:visibility="visible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/whoop_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/edit_device_name_sheet_handle_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.StandardAndHalf"
        android:contentDescription="@string/sheet_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/edit_device_name_title"
        app:srcCompat="@drawable/ic_sheet_handle"/>
    <TextView
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/edit_device_name_title"
        android:padding="24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/name_your_strap"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_device_name_transparent_toolbar_space"
        style="@style/Header.H4"/>
    <TextView
        android:textColor="@color/Whoop.Gray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/name_strap_hint"
        app:layout_constraintBottom_toTopOf="@+id/edit_device_name_input_layout"
        app:layout_constraintStart_toStartOf="@+id/edit_device_name_input_layout"
        style="@style/Headline5"/>
    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/EditDeviceNameEditTextAppearance"
        android:id="@+id/edit_device_name_input_layout"
        android:background="@color/black_opacity_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="40dp"
        app:endIconMode="clear_text"
        app:endIconTint="@color/black"
        app:errorEnabled="true"
        app:hintTextAppearance="@style/EditDeviceNameHintTextAppearance"
        app:layout_constraintBottom_toTopOf="@+id/edit_device_name_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_device_name_title">
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="@color/black"
            android:id="@+id/edit_device_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSend"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:textColor="@drawable/edit_device_name_save_button_text_color"
        android:gravity="center"
        android:id="@+id/edit_device_name_save"
        android:background="@drawable/bg_edit_name_save"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/action_save"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_device_name_input_layout"/>
    <TextView
        android:textColor="@drawable/edit_device_name_save_button_text_color"
        android:gravity="center"
        android:id="@+id/edit_device_name_default"
        android:background="@drawable/bg_edit_name_save"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/action_default_name"
        android:textAllCaps="true"
        android:fontFamily="@font/alphabetic_font_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_device_name_save"/>
</androidx.constraintlayout.widget.ConstraintLayout>
