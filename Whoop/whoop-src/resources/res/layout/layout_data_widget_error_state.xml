<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_data_widget_error_state_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/data_widget_error_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_chat_try_again"
        android:contentDescription="@string/community_ama_network_error_cd"
        app:layout_constraintBottom_toTopOf="@+id/data_widget_error_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/data_widget_error_title"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/Margin.Double"
        android:text="@string/community_error_retrieving"
        app:layout_constraintBottom_toTopOf="@+id/data_widget_error_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_widget_error_icon"
        style="@style/Headline5"/>
    <TextView
        android:textColor="@color/white_50"
        android:gravity="center"
        android:id="@+id/data_widget_error_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/Margin.Double"
        android:text="@string/community_ama_network_error"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toTopOf="@+id/data_widget_try_again"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_widget_error_title"
        style="@style/Headline5"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textColor="@color/Whoop.White"
        android:id="@+id/data_widget_try_again"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:text="@string/community_try_again"
        android:paddingStart="@dimen/Margin.Sextuple"
        android:paddingEnd="@dimen/Margin.Sextuple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/data_widget_error_description"
        app:strokedPillStrokeColor="@color/Whoop.White"
        app:strokedPillStrokeWidth="2dp"
        style="@style/AmaStrokedPillButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
