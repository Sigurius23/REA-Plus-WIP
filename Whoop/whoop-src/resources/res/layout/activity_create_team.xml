<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_create_team_0"
    android:background="@color/Whoop.Black.SlightlyLight"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.whoop.community.presentation.p059ui.SwipelessViewPager
        android:layout_gravity="top"
        android:id="@+id/bannerPager"
        android:layout_width="match_parent"
        android:layout_height="400dp"/>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/bannerPagerFade"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:src="@drawable/bg_bottom_dark_fade"/>
    <com.whoop.p069ui.WhoopZoomageView
        android:layout_gravity="top"
        android:id="@+id/bannerCrop"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:foreground="@drawable/bg_bottom_dark_fade"/>
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/toolbar"/>
        <com.whoop.p069ui.ThrobberView
            android:layout_gravity="center"
            android:id="@+id/throbberView"
            android:layout_width="64dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.whoop.p069ui.pills.StrokedPillButton
            android:textAppearance="@style/Whoop.Text.H1.White"
            android:textColor="@color/Whoop.Red"
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/community_action_next"
            android:layout_marginHorizontal="0x7f07000e"
            android:layout_marginVertical="@dimen/Margin.Standard"
            app:strokedPillColor="@color/Whoop.Black"
            app:strokedPillNormalAlpha="1"
            app:strokedPillStrokeColor="@color/Whoop.Red"
            app:strokedPillUseStaticAlpha="false"
            style="@style/Button.Flat"/>
    </LinearLayout>
</FrameLayout>
