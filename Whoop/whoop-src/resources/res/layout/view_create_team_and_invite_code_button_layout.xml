<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_create_team_and_invite_code_button_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button_invite_code"
        android:background="@color/whoop_white_opacity_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        app:layout_constraintBottom_toTopOf="@+id/button_create_team"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_community_browse"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="15dp"/>
        <TextView
            android:textSize="@dimen/text_size_slightly_small"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enter_invite_code"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:letterSpacing="0.1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button_create_team"
        android:background="@color/whoop_white_opacity_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_invite_code">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add_rounded"
            android:alpha="0.5"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp"/>
        <TextView
            android:textSize="@dimen/text_size_slightly_small"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/team_create_team"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:letterSpacing="0.1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
