<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/activity_joinTeamConfirmation_background"
        android:src="@drawable/bg_blue_gradient"
        style="@style/Login.Background"/>
    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/Margin.Triple"
        android:layout_marginStart="0x7f07000e"
        android:layout_marginEnd="0x7f07000e">
        <ImageView
            android:id="@+id/activity_joinTeamConfirmation_whoopLogo"
            android:layout_marginBottom="@dimen/Margin.Standard"
            style="@style/Login.Logo"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/activity_joinTeamConfirmation_teamIconGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_gravity="center"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@color/Whoop.Black.QuarterOpacity"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_gravity="center"
                android:id="@+id/activity_joinTeamConfirmation_teamIcon"
                android:layout_width="108dp"
                android:layout_height="108dp"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/text_size_semi_large"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/activity_joinTeamConfirmation_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0x7f07000e"
            android:layout_marginBottom="0x7f07000e"
            android:fontFamily="@font/alphabetic_font_bold"
            style="@style/Text"/>
        <TextView
            android:textSize="@dimen/text_size_standard"
            android:textColor="@color/Whoop.Blue.Medium"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/JoinTeam.Confirmation.Subtext"
            android:fontFamily="@font/alphabetic_font_regular"
            style="@style/Text"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="2"/>
        <com.whoop.p069ui.pills.StrokedPillButton
            android:id="@+id/activity_joinTeamConfirmation_gotIt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/community_action_got_it"
            app:strokedPillColor="@color/Whoop.White"
            style="@style/Button.StrokedPill"/>
    </LinearLayout>
</FrameLayout>
