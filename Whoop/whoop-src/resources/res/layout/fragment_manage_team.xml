<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_manage_team_0"
    android:background="@color/Whoop.Black.SlightlyLight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:foreground="@drawable/bg_bottom_dark_fade"
        android:src="@drawable/team_banner_1"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.whoop.p069ui.WhoopZoomageView
        android:id="@+id/bannerCropImage"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:foreground="@drawable/bg_bottom_dark_fade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.whoop.p069ui.ThrobberView
        android:id="@+id/throbberView"
        android:layout_width="64dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.whoop.p069ui.WhoopNewToolbar
        android:id="@+id/manage_toolbar"
        android:background="@color/transparent_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backArrowIcon="@drawable/ic_close"
        app:layout_constraintTop_toTopOf="parent"
        app:toolbarTitle="@string/team_manage_title"
        app:toolbarTitleColor="@color/white"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/noNetworkLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="manage_team_no_network_view,noNetworkText"/>
    <com.whoop.p069ui.views.ColoredImageView
        android:id="@+id/manage_team_no_network_view"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_margin="@dimen/Margin.Double"
        android:src="@drawable/ic_no_network"
        app:coloredImageViewColorFilter="@color/Whoop.White"
        app:layout_constraintBottom_toTopOf="@+id/noNetworkText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manage_toolbar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="@color/Whoop.Gray"
        android:gravity="center"
        android:id="@+id/noNetworkText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/Margin.Double"
        android:text="@string/community_teams_nonetwork"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manage_team_no_network_view"
        style="@style/Whoop.Text.MediumSmallNumber"/>
    <include
        android:id="@+id/bannerPicker"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manage_toolbar"
        layout="@layout/layout_team_pick_image"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/bannerCropper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="banner_drag_zoom_flow,bannerCropOk"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/banner_drag_zoom_flow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="196dp"
        app:constraint_referenced_ids="banner_drag_zoom_icon,banner_drag_zoom_text"
        app:flow_horizontalGap="@dimen/Margin.Double"
        app:flow_horizontalStyle="packed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manage_toolbar"/>
    <ImageView
        android:id="@+id/banner_drag_zoom_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_drag_zoom"
        android:importantForAccessibility="no"
        app:tint="@color/Whoop.Gray"/>
    <TextView
        android:id="@+id/banner_drag_zoom_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/team_create_drag_banner"
        style="@style/Teams.SectionLabel"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textAppearance="@style/Whoop.Text.H1.White"
        android:textColor="@color/Whoop.Red"
        android:id="@+id/bannerCropOk"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/community_action_save"
        android:layout_marginHorizontal="0x7f07000e"
        android:layout_marginVertical="@dimen/Margin.Standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/banner_drag_zoom_flow"
        app:strokedPillColor="@color/Whoop.Black"
        app:strokedPillNormalAlpha="1"
        app:strokedPillStrokeColor="@color/Whoop.Red"
        app:strokedPillUseStaticAlpha="false"
        style="@style/Button.Flat"/>
    <include
        android:id="@+id/logoPicker"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manage_toolbar"
        layout="@layout/layout_team_pick_logo"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/logoCropper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="logoCropImage,logo_drag_zoom_flow,logoCropOk"/>
    <com.whoop.p069ui.WhoopZoomageView
        android:id="@+id/logoCropImage"
        android:layout_width="196dp"
        android:layout_height="196dp"
        android:layout_marginTop="76dp"
        android:layout_marginBottom="@dimen/Margin.Double"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manage_toolbar"
        app:zoomage_circleMask="true"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/logo_drag_zoom_flow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="0x7f07000e"
        app:constraint_referenced_ids="logo_drag_zoom_icon,logo_drag_zoom_text"
        app:flow_horizontalGap="@dimen/Margin.Double"
        app:flow_horizontalStyle="packed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoCropImage"/>
    <ImageView
        android:id="@+id/logo_drag_zoom_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_drag_zoom"
        android:importantForAccessibility="no"
        app:tint="@color/Whoop.Gray"/>
    <TextView
        android:id="@+id/logo_drag_zoom_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/team_create_drag_logo"
        android:layout_marginStart="@dimen/Margin.Double"
        style="@style/Teams.SectionLabel"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textAppearance="@style/Whoop.Text.H1.White"
        android:textColor="@color/Whoop.Red"
        android:id="@+id/logoCropOk"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/community_action_save"
        android:layout_marginHorizontal="0x7f07000e"
        android:layout_marginVertical="@dimen/Margin.Standard"
        app:layout_constraintTop_toBottomOf="@+id/logo_drag_zoom_flow"
        app:strokedPillColor="@color/Whoop.Black"
        app:strokedPillNormalAlpha="1"
        app:strokedPillStrokeColor="@color/Whoop.Red"
        app:strokedPillUseStaticAlpha="false"
        style="@style/Button.Flat"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manage_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_constraint_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/Margin.Quintuple">
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/editBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Sextuple"
                app:constraint_referenced_ids="edit_banner_image,edit_banner_text"
                app:flow_horizontalGap="@dimen/Margin.Double"
                app:flow_horizontalStyle="packed"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/edit_banner_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_edit_profile"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/Margin.Double"/>
            <TextView
                android:id="@+id/edit_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/team_edit_banner"
                style="@style/Teams.SectionLabel"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/editLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="logoImage,edit_logo_pencil_icon"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/logoImage"
                android:layout_width="96dp"
                android:layout_height="0dp"
                android:layout_margin="@dimen/Margin.Double"
                android:layout_marginTop="@dimen/Margin.Sextuple"
                android:layout_marginStart="@dimen/Margin.Double"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editBanner"/>
            <ImageView
                android:id="@+id/edit_logo_pencil_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_edit_profile"
                android:scaleType="centerInside"
                android:contentDescription="@string/community_acc_logo_edit"
                app:layout_constraintBottom_toBottomOf="@+id/logoImage"
                app:layout_constraintEnd_toEndOf="@+id/logoImage"
                app:layout_constraintStart_toStartOf="@+id/logoImage"
                app:layout_constraintTop_toTopOf="@+id/logoImage"/>
            <TextView
                android:id="@+id/edit_team_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Double"
                android:layout_marginBottom="@dimen/Margin.Standard"
                android:text="@string/team_name"
                android:layout_marginStart="@dimen/Margin.Standard"
                android:labelFor="@+id/editTeamName"
                app:layout_constraintBottom_toTopOf="@+id/editTeamName"
                app:layout_constraintStart_toEndOf="@+id/logoImage"
                app:layout_constraintTop_toTopOf="@+id/logoImage"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/Teams.SectionLabel"/>
            <EditText
                android:textColor="@color/Whoop.White"
                android:gravity="start"
                android:id="@+id/editTeamName"
                android:background="@drawable/bg_edittext_dropshadow_on_dark"
                android:paddingTop="@dimen/Margin.Standard"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:maxLines="1"
                android:inputType="text"
                android:layout_marginEnd="@dimen/Margin.Double"
                android:paddingHorizontal="@dimen/Margin.Standard"
                android:importantForAutofill="no"
                app:layout_constraintBottom_toBottomOf="@+id/logoImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/edit_team_name_text"
                app:layout_constraintTop_toBottomOf="@+id/edit_team_name_text"
                style="@style/Teams.Data"/>
            <TextView
                android:id="@+id/team_description_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Double"
                android:layout_marginBottom="@dimen/Margin.Standard"
                android:text="@string/team_description"
                android:labelFor="@+id/editDescription"
                android:layout_marginHorizontal="@dimen/Margin.Double"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logoImage"
                style="@style/Teams.SectionLabel"/>
            <EditText
                android:textColor="@color/Whoop.White"
                android:gravity="start|top"
                android:id="@+id/editDescription"
                android:background="@drawable/bg_edittext_dropshadow_on_dark"
                android:padding="@dimen/Margin.Double"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/Margin.Standard"
                android:layout_marginBottom="@dimen/Margin.Triple"
                android:layout_weight="1"
                android:inputType="textMultiLine"
                android:layout_marginHorizontal="@dimen/Margin.Double"
                android:importantForAutofill="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/team_description_label"
                style="@style/Teams.Data"/>
            <TextView
                android:id="@+id/team_chat_label"
                android:layout_width="wrap_content"
                android:layout_marginTop="0x7f07000e"
                android:text="@string/team_chat"
                android:fontFamily="@font/alphabetic_font_semibold"
                android:layout_marginStart="@dimen/Margin.Double"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editDescription"
                style="@style/Headline3"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/team_chat_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/Margin.Double"
                app:layout_constraintBottom_toBottomOf="@+id/team_chat_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/team_chat_label"
                app:thumbTint="@drawable/selector_chat_toggle_thumb"
                app:trackTint="@drawable/selector_chat_toggle_track"/>
            <com.whoop.p069ui.pills.StrokedPillButton
                android:textAppearance="@style/Whoop.Text.H1.White"
                android:textColor="@color/Whoop.White"
                android:id="@+id/removeMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Triple"
                android:text="@string/team_remove"
                android:layout_marginStart="@dimen/Margin.Double"
                android:layout_marginEnd="@dimen/Margin.Double"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/team_chat_label"
                app:strokedPillColor="@color/Whoop.Black"
                app:strokedPillNormalAlpha="1"
                app:strokedPillStrokeColor="@color/Whoop.White"
                app:strokedPillUseStaticAlpha="false"
                style="@style/Button.Flat"/>
            <com.whoop.p069ui.pills.StrokedPillButton
                android:textAppearance="@style/Whoop.Text.H1.White"
                android:textColor="@color/Whoop.Red"
                android:id="@+id/transferOwnership"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Triple"
                android:text="@string/team_transfer"
                android:layout_marginStart="@dimen/Margin.Double"
                android:layout_marginEnd="@dimen/Margin.Double"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/removeMembers"
                app:strokedPillColor="@color/Whoop.Black"
                app:strokedPillNormalAlpha="1"
                app:strokedPillStrokeColor="@color/Whoop.Red"
                app:strokedPillUseStaticAlpha="false"
                style="@style/Button.Flat"/>
            <com.whoop.p069ui.pills.StrokedPillButton
                android:textAppearance="@style/Whoop.Text.H1.White"
                android:textColor="@color/Whoop.Red"
                android:id="@+id/deleteTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Triple"
                android:text="@string/team_delete"
                android:layout_marginStart="@dimen/Margin.Double"
                android:layout_marginEnd="@dimen/Margin.Double"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/transferOwnership"
                app:strokedPillColor="@color/Whoop.Black"
                app:strokedPillNormalAlpha="1"
                app:strokedPillStrokeColor="@color/Whoop.Red"
                app:strokedPillUseStaticAlpha="false"
                style="@style/Button.Flat"/>
            <TextView
                android:textColor="@color/Whoop.Gray"
                android:gravity="center_horizontal"
                android:id="@+id/transferNoticeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Margin.Double"
                android:layout_marginBottom="@dimen/Margin.Sextuple"
                android:text="@string/team_transfer_warning"
                android:layout_marginStart="@dimen/Margin.Double"
                android:layout_marginEnd="@dimen/Margin.Double"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/deleteTeam"
                style="@style/Teams.Data"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
