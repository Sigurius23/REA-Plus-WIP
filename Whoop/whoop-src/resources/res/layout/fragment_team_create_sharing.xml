<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_team_create_sharing_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/teamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/Margin.Double"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Teams.Title"/>
    <TextView
        android:id="@+id/create_choose_leaderboards_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/team_create_choose_leaderboards"
        app:layout_constraintBottom_toTopOf="@+id/create_choose_leaderboards_subtext"
        app:layout_constraintStart_toStartOf="@+id/create_choose_leaderboards_subtext"
        style="@style/Teams.SectionLabel"/>
    <TextView
        android:id="@+id/create_choose_leaderboards_subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/Margin.Double"
        android:text="@string/team_create_choose_leaderboards_subtext"
        android:layout_marginEnd="@dimen/Margin.Standard"
        app:layout_constraintBottom_toTopOf="@+id/strain_toggle"
        app:layout_constraintEnd_toStartOf="@+id/helpButton"
        app:layout_constraintStart_toStartOf="@+id/strain_toggle"
        style="@style/Teams.Data"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/helpButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_context_help"
        android:contentDescription="@string/community_help"
        app:layout_constraintBottom_toBottomOf="@+id/create_choose_leaderboards_subtext"
        app:layout_constraintEnd_toEndOf="@+id/strain_toggle"
        app:tint="@color/Whoop.Gray"/>
    <include
        android:id="@+id/strain_toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/Margin.Double"
        app:layout_constraintBottom_toTopOf="@+id/recovery_toggle"
        app:layout_constraintEnd_toEndOf="@+id/recovery_toggle"
        app:layout_constraintStart_toStartOf="@+id/recovery_toggle"
        layout="@layout/view_team_leaderboard_toggle"/>
    <include
        android:id="@+id/recovery_toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/Margin.Double"
        app:layout_constraintBottom_toTopOf="@+id/sleep_toggle"
        app:layout_constraintEnd_toEndOf="@+id/sleep_toggle"
        app:layout_constraintStart_toStartOf="@+id/sleep_toggle"
        layout="@layout/view_team_leaderboard_toggle"/>
    <include
        android:id="@+id/sleep_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/Margin.Double"
        android:layout_marginStart="0x7f07000e"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/view_team_leaderboard_toggle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
