<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.whoop.p069ui.views.ColoredImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/view_tooltip_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/popup_arrow"
        android:scaleType="center"
        app:coloredImageViewColorFilter="@color/Whoop.Orange"/>
    <FrameLayout
        android:id="@+id/view_tooltip_frame"
        android:background="@drawable/bg_popup_orange"
        android:padding="@dimen/Margin.Double"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="@dimen/text_size_standard"
            android:id="@+id/view_tooltip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/alphabetic_font_semibold"
            style="@style/Text.Default"/>
    </FrameLayout>
</merge>
