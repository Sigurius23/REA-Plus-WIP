<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_container"
    android:layout_width="match_parent"
    android:layout_height="?android:attr/actionBarSize"
    style="@style/WhoopActionBar">
    <ImageView
        android:id="@+id/back_iv"
        android:layout_width="?android:attr/actionBarSize"
        android:layout_height="?android:attr/actionBarSize"
        android:src="@drawable/ic_arrow_back"
        android:scaleType="center"
        android:contentDescription="@string/action_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/data_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_time"
        android:lines="1"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:autoSizeMaxTextSize="32sp"
        app:autoSizeMinTextSize="24sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back_iv"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Number4"/>
    <com.whoop.p069ui.views.ColoredImageView
        android:layout_gravity="center"
        android:id="@+id/toolbar_subject_iv"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_sleep_need"
        android:layout_marginEnd="@dimen/Margin.Half"
        app:coloredImageViewColorFilter="@color/Whoop.White"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/data_tv"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/title_subject_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="@dimen/Margin.Half"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/option_iv"
        app:layout_constraintStart_toEndOf="@+id/toolbar_subject_iv"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/Whoop.Sleep.Green"
            android:ellipsize="end"
            android:id="@+id/subject_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeTextType="uniform"
            style="@style/Headline4"/>
        <TextView
            android:textColor="@color/Whoop.Blue.Medium"
            android:id="@+id/subject_sub_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            style="@style/Headline5"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_help_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/toolbar_subject_iv"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/Whoop.Sleep.Green"
            android:ellipsize="end"
            android:id="@+id/main_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform"
            style="@style/Headline4"/>
        <ImageView
            android:id="@+id/help_button"
            android:background="@null"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="?android:attr/actionBarSize"
            android:scaleType="center"
            android:contentDescription="@string/help_button"
            android:alpha="0.3"
            app:srcCompat="0x7f08056b"
            app:tint="@color/white"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/option_iv"
        android:visibility="gone"
        android:layout_width="?android:attr/actionBarSize"
        android:layout_height="?android:attr/actionBarSize"
        android:scaleType="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
