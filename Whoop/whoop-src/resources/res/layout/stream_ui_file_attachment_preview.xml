<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/stream_ui_shape_selected_media_round"
    android:layout_width="@dimen/stream_ui_message_composer_file_attachment_width"
    android:layout_height="@dimen/stream_ui_message_composer_attachment_height"
    android:layout_marginHorizontal="@dimen/stream_ui_spacing_tiny">
    <ImageView
        android:id="@+id/fileThumbImageView"
        android:layout_width="@dimen/stream_ui_attachment_dialog_file_type_width"
        android:layout_height="@dimen/stream_ui_attachment_dialog_file_type_height"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/StreamUiTextAppearance.BodyBold"
        android:ellipsize="end"
        android:id="@+id/fileNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/stream_ui_spacing_medium"
        android:layout_marginEnd="@dimen/stream_ui_spacing_medium"
        app:layout_constraintBottom_toTopOf="@+id/fileSizeTextView"
        app:layout_constraintEnd_toStartOf="@+id/removeButton"
        app:layout_constraintStart_toEndOf="@+id/fileThumbImageView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/StreamUiTextAppearance.Footnote"
        android:id="@+id/fileSizeTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/stream_ui_spacing_medium"
        android:layout_marginEnd="@dimen/stream_ui_spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fileThumbImageView"
        app:layout_constraintTop_toBottomOf="@+id/fileNameTextView"/>
    <ImageButton
        android:id="@+id/removeButton"
        android:background="@drawable/stream_ui_circle_white"
        android:padding="6dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/stream_ui_ic_close_white"
        android:scaleType="center"
        android:cropToPadding="true"
        android:backgroundTint="@color/stream_ui_overlay_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
