<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_tonights_sleep_container_0"
    android:background="@color/black_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/time_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tonights_sleep_bar">
        <TextView
            android:textAppearance="@style/Whoop.Text.SleepTime"
            android:gravity="center"
            android:id="@+id/time_to_bed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAllCaps="false"
            android:layout_marginStart="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/wake_time_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/wake_time_value"/>
        <TextView
            android:textAppearance="@style/Whoop.Text.H6"
            android:gravity="center"
            android:id="@+id/time_to_bed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/time_to_bed_value"
            app:layout_constraintStart_toStartOf="@+id/time_to_bed_value"
            app:layout_constraintTop_toBottomOf="@+id/time_to_bed_value"/>
        <TextView
            android:textAppearance="@style/Whoop.Text.SleepTime"
            android:gravity="center"
            android:id="@+id/wake_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="30dp"
            app:layout_constraintBottom_toTopOf="@+id/wake_time_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/Whoop.Text.H6"
            android:gravity="center"
            android:id="@+id/wake_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="@+id/wake_time_value"
            app:layout_constraintStart_toStartOf="@+id/wake_time_value"
            app:layout_constraintTop_toBottomOf="@+id/wake_time_value"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.whoop.coaching.sleepcoach.harvard.view.OptimalSleepView
        android:id="@+id/optimal_sleep_tonight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tonights_sleep_bar"/>
    <com.whoop.coaching.sleepcoach.harvard.view.TonightSleepBar
        android:id="@+id/tonights_sleep_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_twenty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_thirty_six"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.65"/>
    <View
        android:id="@+id/tonights_sleep_bar_clickable_area"
        android:layout_width="70dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_thirty_six"
        app:layout_constraintEnd_toEndOf="@+id/tonights_sleep_bar"
        app:layout_constraintStart_toStartOf="@+id/tonights_sleep_bar"
        app:layout_constraintTop_toBottomOf="@+id/guideline_twenty"/>
    <include
        android:id="@+id/low_battery_pop_up_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/sleep_coach_view_sleep_coach_low_battery_message"/>
</androidx.constraintlayout.widget.ConstraintLayout>
