<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alarm_set_state_container"
    android:background="@color/black_opacity_90"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/alarm_set_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:text="@string/sleep_coach_saving_wake_time_set_alarm"
        app:layout_constraintBottom_toTopOf="@+id/alarm_set_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Headline3"/>
    <TextView
        android:textColor="@color/white_50"
        android:gravity="center"
        android:id="@+id/alarm_set_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.StandardAndHalf"
        android:layout_marginBottom="12dp"
        android:text="@string/sleep_coach_saving_wake_time_set_alarm_description"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        app:layout_constraintBottom_toTopOf="@+id/save_and_set_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alarm_set_title"
        style="@style/Paragraph1"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textAppearance="@style/Whoop.Text.H2"
        android:textColor="@drawable/selector_text_dark"
        android:id="@+id/save_and_set_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.DoubleAndHalf"
        android:text="@string/sleep_coach_save_amp_set_alarm"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintBottom_toTopOf="@+id/save_wake_time_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alarm_set_description"
        app:strokedPillColor="@color/whoop_white"
        app:strokedPillNormalAlpha="0"
        app:strokedPillStrokeColor="@color/whoop_white"
        style="@style/Button.StrokedPill"/>
    <TextView
        android:textAppearance="@style/Whoop.Text.H2"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/save_wake_time_button"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.ContentInset"
        android:text="@string/sleep_coach_saving_wake_time_just_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/save_and_set_button"
        style="@style/Headline4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
