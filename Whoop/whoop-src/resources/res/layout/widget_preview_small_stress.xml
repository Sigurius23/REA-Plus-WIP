<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/widget_stress_preview_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_widget_stress"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#00f19f"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_stress_preview_score"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#00f19f"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_stress_level_med"/>
</LinearLayout>
