<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_ble_container"
    android:tag="layout/activity_ble_connect_strap_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/Whoop.Background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/connect_strap_footer_fade"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/connect_strap_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:fitsSystemWindows="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/connect_strap_back"
                    layout="@layout/layout_back"/>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/welcome_to_whoop"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/whoop_logo"
                    android:layout_centerHorizontal="true"
                    style="@style/Login.Logo"/>
                <TextView
                    android:gravity="bottom"
                    android:id="@+id/ble_connect_strap_subtitle"
                    android:layout_height="@dimen/Login.Logo.VerticalOffset"
                    android:text="@string/Login.ConnectStrap.Subtitle"
                    android:layout_centerHorizontal="true"
                    style="@style/Login.Subtitle"/>
            </RelativeLayout>
        </FrameLayout>
        <FrameLayout
            android:gravity="center_vertical"
            android:id="@+id/connect_strap_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ble_connect_strap_phone"
                android:layout_width="180dp"
                android:layout_height="260dp"
                android:src="@drawable/ic_phone_updated"
                android:adjustViewBounds="true"
                android:translationX="-40dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ble_connect_strap_strap"
                android:layout_width="180dp"
                android:layout_height="260dp"
                android:src="@drawable/ic_whoop_strap_pairing"
                android:adjustViewBounds="true"/>
            <ViewFlipper
                android:id="@+id/line_flipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/line_connected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="50dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@color/Whoop.Green"
                        android:layout_width="match_parent"
                        android:layout_height="2.5dp"
                        android:layout_marginStart="@dimen/Margin.Double"
                        android:layout_marginEnd="@dimen/Margin.DoubleAndHalf"/>
                    <com.whoop.p069ui.views.ColoredImageView
                        android:layout_gravity="center"
                        android:background="@drawable/ic_connected_check_background"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_check"
                        app:coloredImageViewColorFilter="@color/Whoop.White"/>
                    <View
                        android:layout_gravity="center"
                        android:background="@drawable/ic_line_cap_green"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="@dimen/Margin.Double"/>
                    <View
                        android:layout_gravity="center"
                        android:background="@drawable/ic_line_cap_green"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="@dimen/Margin.DoubleAndHalf"/>
                </FrameLayout>
                <FrameLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/activity_bleConnectStrap_lineConnecting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="50dp">
                    <com.whoop.p069ui.views.ConnectingAnimationView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/connecting_animation_view"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/Margin.DoubleAndHalf"
                        android:layout_marginEnd="@dimen/Margin.DoubleAndHalf"/>
                </FrameLayout>
            </ViewFlipper>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/connect_strap_messaging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/connect_strap_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Login.ConnectStrap.Ble.Connecting.Title"
                style="@style/LegacyPairingFlow.HeadLine3"/>
            <TextView
                android:id="@+id/connect_strap_message"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/Margin.Standard"
                android:layout_marginBottom="@dimen/Margin.Double"
                android:text="@string/Login.ConnectStrap.Ble.Connecting.MessageFormat"
                android:lines="4"
                android:layout_marginHorizontal="@dimen/Margin.Triple"
                style="@style/LegacyPairingFlow.ConnectStrap.Message"/>
            <Button
                android:id="@+id/connect_strap_button"
                android:visibility="invisible"
                android:layout_marginBottom="0x7f07000e"
                android:text="@string/action_continue"
                style="@style/Legacy.Pairing.Flow.Button"/>
        </LinearLayout>
    </LinearLayout>
    <com.whoop.p069ui.drawer.strapsettings.connectstrap.ConnectStrapNetworkErrorView
        android:id="@+id/network_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
