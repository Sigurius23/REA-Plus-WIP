<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_teams_header_v1_0"
    android:layout_width="match_parent"
    android:layout_height="276dp"
    android:minHeight="170dp">
    <FrameLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="256dp"
        android:minHeight="136dp">
        <ImageView
            android:id="@+id/bannerImage"
            android:background="@drawable/bg_teams_banner_spacer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_bottom_dark_fade"
            android:scaleType="centerCrop"
            android:minHeight="316dp"
            android:contentDescription="@string/community_team_banner_image"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/nameText"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/Margin.Double"
                style="@style/Teams.Title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/leaderboardFilterImage"
                    android:padding="@dimen/Margin.Quarter"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_calendar_filter"
                    android:contentDescription="@string/community_team_filter"
                    android:layout_marginStart="@dimen/Margin.Standard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.whoop.p069ui.pills.StrokedPillButton
                    android:textAppearance="@style/Header.H5"
                    android:id="@+id/btnJumpBackToToday"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:text="@string/community_jump_back_to_today"
                    android:layout_marginStart="@dimen/Margin.Standard"
                    android:layout_marginEnd="@dimen/Margin.Triple"
                    app:layout_constraintBottom_toBottomOf="@+id/leaderboardFilterImage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/leaderboardFilterImage"
                    app:layout_constraintTop_toTopOf="@+id/leaderboardFilterImage"
                    app:strokedPillColor="@android:color/transparent"
                    app:strokedPillNormalAlpha="0"
                    app:strokedPillStrokeColor="@color/white"
                    app:strokedPillStrokeWidth="2dp"
                    app:strokedPillUseStaticAlpha="false"/>
                <com.whoop.community.presentation.p059ui.PillRadioGroup
                    android:id="@+id/segmentSelector"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/selector_height"
                    android:layout_marginStart="@dimen/Margin.Standard"
                    android:layout_marginEnd="@dimen/Margin.Triple"
                    app:layout_constraintBottom_toBottomOf="@+id/leaderboardFilterImage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/leaderboardFilterImage"
                    app:layout_constraintTop_toTopOf="@+id/leaderboardFilterImage"
                    app:values="@array/community_Teams.Segments"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/Whoop.Blue"
                    android:id="@+id/sortOptionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/Margin.StandardAndHalf"
                    android:fontFamily="@font/alphabetic_font_semibold"
                    android:layout_marginStart="@dimen/Margin.Triple"
                    android:layout_marginEnd="@dimen/Margin.Triple"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/leaderboardFilterImage"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/Whoop_Blue_Opaque"
                    android:id="@+id/teamAverageText"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/team_average"
                    android:fontFamily="@font/alphabetic_font_semibold"
                    app:layout_constraintStart_toStartOf="@+id/sortOptionText"
                    app:layout_constraintTop_toBottomOf="@+id/sortOptionText"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/selectedDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/Margin.StandardAndHalf"
                    android:fontFamily="@font/alphabetic_font_semibold"
                    android:layout_marginEnd="@dimen/Margin.Triple"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/leaderboardFilterImage"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white_60"
                    android:id="@+id/lastUpdatedText"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/community_last_updated_date_time"
                    android:fontFamily="@font/alphabetic_font_semibold"
                    app:layout_constraintEnd_toEndOf="@+id/selectedDateText"
                    app:layout_constraintTop_toBottomOf="@+id/selectedDateText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/recyclerShade"
        android:background="@drawable/bg_top_dark_fade"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</LinearLayout>
