<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_daystrain_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/view_daystrain_title"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/Margin.Double"
        android:lines="1"
        app:autoSizeMaxTextSize="13sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Headline4"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/training_state_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/Margin.Triple"
        app:layout_constraintTop_toBottomOf="@+id/view_daystrain_title">
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/view_daystrain_currentDayStrainCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/place_holder_long_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guideline_twenty_eight"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:realTimeCellIcon="@drawable/ic_trainstate_current"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconWidth="18dp"
            app:realTimeLabelColor="@color/Whoop.Gray"
            app:realTimeValueColor="@color/Whoop.Black"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/Margin.Standard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guideline_thirty_eight"
            app:layout_constraintStart_toStartOf="@+id/guideline_twenty_eight"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/Whoop.Gray"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/view_daystrain_activityStrainCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/place_holder_long_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guideline_sixty"
            app:layout_constraintStart_toStartOf="@+id/guideline_thirty_eight"
            app:layout_constraintTop_toTopOf="parent"
            app:realTimeCellIcon="@drawable/ic_trainstate_activity"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconWidth="18dp"
            app:realTimeLabelColor="@color/Whoop.Gray"
            app:realTimeValueColor="@color/Whoop.Black"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/Margin.Standard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guideline_seventy"
            app:layout_constraintStart_toStartOf="@+id/guideline_sixty"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/Whoop.Gray"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/view_daystrain_estimatedDayStrainCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/place_holder_long_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline_seventy"
            app:layout_constraintTop_toTopOf="parent"
            app:realTimeCellIcon="@drawable/ic_trainstate_estimated"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconWidth="18dp"
            app:realTimeLabelColor="@color/Whoop.Gray"
            app:realTimeValueColor="@color/Whoop.Black"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_twenty_eight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.28"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_thirty_eight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.38"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_sixty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.6"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_seventy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.7"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/day_strain_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/StrainCoach.Label.DayStrain"
        android:lines="1"
        android:textAllCaps="true"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toBottomOf="@+id/training_state_layout"
        style="@style/Headline5"/>
    <FrameLayout
        android:id="@+id/strain_graph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/day_strain_tv">
        <com.whoop.realtime.presentation.views.StrainCoachStrainGraph
            android:id="@+id/view_daystrain_straingraph"
            android:layout_width="match_parent"
            android:layout_height="220dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/view_daystrain_recoveryRequired_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_incomplete_data"
                app:tint="@color/Whoop.Gray.Light"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/recovery_tv"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:text="@string/StrainCoach.Label.Recovery"
        android:lines="1"
        android:layout_marginEnd="10dp"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="@+id/strain_graph"
        app:layout_constraintTop_toBottomOf="@+id/strain_graph"
        style="@style/Headline5"/>
    <TextView
        android:textColor="@color/Whoop.Gray.Dark"
        android:id="@+id/strain_caveat_tv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/StrainCoach.DayStrain.Caveat"
        android:lines="3"
        android:layout_marginVertical="@dimen/Margin.Standard"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="7sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recovery_tv"
        style="@style/Headline5"/>
    <TextView
        android:textColor="@color/whoop_red"
        android:gravity="center"
        android:id="@+id/view_daystrain_optimaltraining_link"
        android:paddingBottom="20dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/StrainCoach.DayStrain.LearnLink"
        android:lines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:autoSizeMaxTextSize="15sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:drawableStartCompat="@drawable/ic_arrow_forward"
        app:drawableTint="@color/whoop_red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/strain_caveat_tv"
        style="@style/Headline3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
