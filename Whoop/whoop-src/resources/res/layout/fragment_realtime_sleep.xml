<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/fragment_realtime_sleep_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/fragment_realtimeSleep_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/text_size_semi_large"
        android:textColor="@color/Whoop.Blue.Gray"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/fragment_realtimeSleep_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"/>
</FrameLayout>
