<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/drawer_background_gradient_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.whoop.p069ui.WhoopNewToolbar
        android:id="@+id/activity_detection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:toolbarBackgroundColor="@color/transparent_color"
        app:toolbarTitle="@string/training_activity_detection_title"
        app:toolbarTitleColor="@color/white"/>
    <TextView
        android:textSize="@dimen/text_size_semi_large"
        android:textColor="@color/Whoop.White"
        android:layout_gravity="center_vertical"
        android:id="@+id/activity_detection_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:text="@string/training_activity_detection_title"
        android:layout_weight="1"
        android:fontFamily="@font/alphabetic_font_semibold"
        android:layout_marginStart="@dimen/Margin.Double"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_detection_toolbar"/>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/fragment_activityDetectionSettings_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_detection_toolbar"
        app:theme="@style/Theme.Whoop.WhiteAccent"/>
    <TextView
        android:textSize="@dimen/text_size_standard"
        android:textColor="@color/Whoop.White.HalfTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:text="@string/training_activity_detection_description"
        android:fontFamily="@font/alphabetic_font_regular"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:layout_constraintTop_toBottomOf="@+id/activity_detection_label"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fragment_activityDetectionSettings_details"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/Margin.Triple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/activity_detection_graph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:contentDescription="@string/training_activity_detection_graph_content_description"/>
        <TextView
            android:textSize="@dimen/text_size_standard"
            android:textColor="@color/Whoop.White"
            android:gravity="center"
            android:id="@+id/activity_detection_graph_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/training_activity_detection_description_on"
            android:fontFamily="@font/alphabetic_font_regular"
            android:layout_marginStart="@dimen/Margin.Double"
            android:layout_marginEnd="@dimen/Margin.Double"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
