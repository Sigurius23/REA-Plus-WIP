<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/compose_message_menu_0"
    android:background="@color/Whoop.Background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/compose_buttons_v1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/Whoop.White"
            android:gravity="center"
            android:id="@+id/compose_data"
            android:paddingTop="@dimen/Margin.Standard"
            android:paddingBottom="@dimen/Margin.Standard"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/Margin.Half"
            android:text="@string/compose_data"
            android:drawablePadding="@dimen/Margin.StandardAndHalf"
            android:fontFamily="@font/alphabetic_font_semibold"
            app:drawableStartCompat="@drawable/ic_add_data"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/first_divider_layout"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Headline5"/>
        <View
            android:id="@+id/first_divider_layout"
            android:background="@color/white_30"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/Margin.Half"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/compose_add"
            app:layout_constraintStart_toEndOf="@+id/compose_data"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/Whoop.White"
            android:gravity="center"
            android:id="@+id/compose_add"
            android:paddingTop="@dimen/Margin.Standard"
            android:paddingBottom="@dimen/Margin.Standard"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/Margin.Half"
            android:text="@string/compose_add"
            android:drawablePadding="@dimen/Margin.StandardAndHalf"
            android:fontFamily="@font/alphabetic_font_semibold"
            android:layout_marginEnd="@dimen/Margin.Half"
            app:drawableStartCompat="@drawable/ic_stream_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/second_divider_layout"
            app:layout_constraintStart_toEndOf="@+id/first_divider_layout"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Headline5"/>
        <View
            android:id="@+id/second_divider_layout"
            android:background="@color/white_30"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/Margin.Half"
            app:layout_constraintBottom_toBottomOf="@+id/compose_add"
            app:layout_constraintEnd_toStartOf="@+id/compose_send"
            app:layout_constraintStart_toEndOf="@+id/compose_add"
            app:layout_constraintTop_toTopOf="@+id/compose_add"/>
        <TextView
            android:textColor="@color/white_20"
            android:gravity="center"
            android:id="@+id/compose_send"
            android:paddingTop="@dimen/Margin.Standard"
            android:paddingBottom="@dimen/Margin.Standard"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/Margin.Half"
            android:text="@string/compose_send"
            android:drawablePadding="@dimen/Margin.StandardAndHalf"
            android:fontFamily="@font/alphabetic_font_semibold"
            app:drawableStartCompat="@drawable/ic_send_message_disable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/second_divider_layout"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Headline5"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/compose_buttons_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/compose_data_imageonly"
            android:padding="@dimen/Margin.StandardAndHalf"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add_data"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/first_divider_layout_v2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/first_divider_layout_v2"
            android:background="@color/white_30"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/Margin.Half"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/compose_add_imageonly"
            app:layout_constraintStart_toEndOf="@+id/compose_data_imageonly"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/compose_add_imageonly"
            android:padding="@dimen/Margin.StandardAndHalf"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_stream_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/second_divider_layout_v2"
            app:layout_constraintStart_toEndOf="@+id/first_divider_layout_v2"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/second_divider_layout_v2"
            android:background="@color/white_30"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/Margin.Half"
            app:layout_constraintBottom_toBottomOf="@+id/compose_add_imageonly"
            app:layout_constraintEnd_toStartOf="@+id/compose_send_imageonly"
            app:layout_constraintStart_toEndOf="@+id/compose_add_imageonly"
            app:layout_constraintTop_toTopOf="@+id/compose_add_imageonly"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/compose_send_imageonly"
            android:padding="@dimen/Margin.StandardAndHalf"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_send_message_disable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/second_divider_layout_v2"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
