<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/stream_ui_message_composer_overlapping_content_floating_hold_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/stream_ui_white_snow"
        android:gravity="center_vertical"
        android:id="@+id/holdToRecordText"
        android:background="@drawable/stream_ui_message_composer_audio_record_hold_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stream_ui_message_composer_overlapping_content_floating_hold_height"
        android:text="@string/stream_ui_message_composer_hold_to_record_save"
        android:paddingHorizontal="16dp"/>
</FrameLayout>
