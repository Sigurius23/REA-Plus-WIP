<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/layout_teams_overview_header_0"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:minHeight="120dp">
    <FrameLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:minHeight="120dp">
        <ImageView
            android:id="@+id/bannerImage"
            android:background="@drawable/bg_teams_banner_spacer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/bg_bottom_dark_fade"
            android:scaleType="centerCrop"
            android:minHeight="300dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/Margin.Double">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="@dimen/teams_overview_item_label_width"
                android:layout_height="wrap_content">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/bannerIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="@dimen/Margin.Standard"/>
            </LinearLayout>
            <TextView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/nameText"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Teams.Title"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/recyclerShade"
        android:background="@drawable/bg_top_dark_fade"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</LinearLayout>
