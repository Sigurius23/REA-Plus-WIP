<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_real_time_activity_strain_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/whoopLiveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/Margin.Double"
            android:src="@drawable/ic_camera_circled_w"/>
        <com.whoop.realtime.presentation.views.RealTimeStrainDial
            android:layout_gravity="center"
            android:id="@+id/strainDial"
            android:padding="10dp"
            android:layout_width="250dp"
            android:layout_height="250dp"
            app:progressDialDrawEmptyArc="true"
            app:progressDialEmptyColor="@color/Whoop.Black.Opacity30"
            app:progressDialEndColor="@color/Whoop.Gradient.Blue.End"
            app:progressDialGapLength="3"
            app:progressDialStartColor="@color/Whoop.Gradient.Blue.Start"
            app:progressDialThickness="15dp"
            app:progressGoalColor="@color/Whoop.Gray.Opacity30"
            app:strainDialOptimalRangeColor="@color/Whoop.Gray"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="end|top"
            android:orientation="vertical"
            android:id="@+id/activity_realTimeRecord_sharedSnap"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Double"
            android:layout_marginEnd="@dimen/Margin.Double">
            <com.whoop.p069ui.pills.StrokedPillImageButton
                android:layout_gravity="end|top"
                android:id="@+id/fragment_realTimeStrain_live"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="@dimen/Margin.Quarter"
                android:src="@drawable/ic_whoop_live"
                app:strokedPillColor="@color/Whoop.White"/>
            <TextView
                android:textAppearance="@style/Whoop.Text.H3.White"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Activity.RealTime.Live"
                android:textAllCaps="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/strainInProgressContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/Whoop.Text.H3.White"
                android:id="@+id/strainTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/StrainCoach.TitleActivityStrain"
                android:textAllCaps="true"/>
            <TextView
                android:textAppearance="@style/Whoop.Text.LargeNumber"
                android:textSize="68dp"
                android:textColor="@color/Whoop.White"
                android:id="@+id/strainValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"/>
            <TextView
                android:textAppearance="@style/Whoop.Text.H3.White"
                android:id="@+id/strainStateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restorative"
                android:textAllCaps="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/strainCompleteContainer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/strainCompletePortrait"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="8dp"/>
                <ImageView
                    android:layout_gravity="end|top"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:srcCompat="@drawable/ic_check_blue_circle"/>
            </FrameLayout>
            <TextView
                android:textAppearance="@style/Whoop.Text.H2"
                android:textColor="@color/Whoop.Gray"
                android:gravity="center"
                android:id="@+id/fragment_real_time_strain_complete_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/StrainCoach.TitleGoalComplete"
                android:lines="2"
                android:textAllCaps="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/strainProblemContainer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/strainProblemIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="@dimen/Margin.Double"/>
            <TextView
                android:textAppearance="@style/Whoop.Text.H2"
                android:textColor="@color/Whoop.White"
                android:gravity="center"
                android:id="@+id/strainProblemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="2"
                android:textAllCaps="true"/>
            <TextView
                android:textAppearance="@style/Whoop.Text.H3"
                android:textColor="@color/Whoop.Gray"
                android:gravity="center"
                android:id="@+id/strainProblemSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:textAllCaps="true"/>
        </LinearLayout>
    </FrameLayout>
    <com.whoop.realtime.presentation.views.RealTimeCell
        android:gravity="start"
        android:id="@+id/hrCell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:layout_marginStart="@dimen/Margin.Double"
        app:realTimeCellIcon="@drawable/ic_hr"
        app:realTimeCellIconSize="18dp"
        app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
        app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
        app:realTimeLabelText="@string/Activity.RealTime.Cell.HeartRate"
        app:realTimeValueColor="@color/Whoop.White"
        app:realTimeValueText="0"/>
    <com.whoop.realtime.presentation.views.RealTimeStrainRangeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/rangeView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Triple"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"/>
    <androidx.compose.p018ui.platform.ComposeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/rangeView_composeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/activity_realTimeRecord_sharedBottomCells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0x7f07000e"
        android:layout_marginBottom="0x7f07000e"
        android:paddingStart="@dimen/Margin.Double"
        android:paddingEnd="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Standard"
        android:layout_marginEnd="@dimen/Margin.Standard">
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/avgHrCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:realTimeCellIcon="@drawable/ic_hr"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/Activity.RealTime.Cell.AvgHr"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
        <View
            android:id="@+id/activity_realTimeRecord_sharedDiv1"
            android:background="@color/Whoop.White.MostlyTransparent"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/Margin.Double"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/maxHrCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/Margin.Double"
            app:realTimeCellIcon="@drawable/ic_hr_max"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/Activity.RealTime.Cell.MaxHr"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
        <View
            android:id="@+id/activity_realTimeRecord_sharedDiv2"
            android:background="@color/Whoop.White.MostlyTransparent"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/Margin.Double"/>
        <com.whoop.realtime.presentation.views.RealTimeCell
            android:id="@+id/calorieCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:realTimeCellIcon="@drawable/ic_calories"
            app:realTimeCellIconSize="18dp"
            app:realTimeCellIconTint="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelColor="@color/Whoop_White_ThirdTransparent"
            app:realTimeLabelText="@string/Activity.RealTime.Cell.Calories"
            app:realTimeValueColor="@color/Whoop.White"
            app:realTimeValueText="0"/>
    </LinearLayout>
</LinearLayout>
