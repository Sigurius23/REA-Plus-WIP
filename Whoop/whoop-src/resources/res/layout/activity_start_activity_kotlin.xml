<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:tag="layout/activity_start_activity_kotlin_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordin_root"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_buttons_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbarContainer">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/gps_container"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/nonGpsBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="260dp"
                    android:src="0x7f0805fb"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ViewStub
                    android:id="@+id/gpsMap"
                    android:layout="@layout/layout_gps_map"
                    android:inflatedId="@+id/gpsMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/gpsSwitchContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/Margin.Double"
                    android:layoutDirection="ltr"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textColor="@color/Whoop.Gray"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/StrainCoach.TrackRoute"
                        android:maxLines="1"
                        android:layout_marginEnd="@dimen/Margin.Standard"
                        android:letterSpacing="0"
                        style="@style/Whoop.Text.H3"/>
                    <com.whoop.p069ui.WhoopSwitch
                        android:id="@+id/gpsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layoutDirection="locale"
                        app:whoopSwitchChecked="true"/>
                </LinearLayout>
                <com.whoop.p069ui.views.LiveHeartRateView
                    android:id="@+id/heartRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/Margin.Double"
                    android:alpha="0.88"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/nonGpsBackground"/>
                <View
                    android:id="@+id/startButtonAnchor"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/nonGpsBackground"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/strain_coach_sheet"
                android:background="@drawable/bg_rounded_corner_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:behavior_hideable="false"
                app:behavior_peekHeight="75dp"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/strain_coach_sheet_cd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/Margin.Double"
                    android:contentDescription="@string/open_strain_coach"
                    app:srcCompat="@drawable/ic_sheet_handle"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/Margin.Standard">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/miniDialContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.whoop.p069ui.ProgressDial
                            android:layout_gravity="center_vertical"
                            android:id="@+id/strainGoalMiniDial"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="@dimen/Margin.Double"
                            app:progressDialDrawEmptyArc="true"
                            app:progressDialEmptyColor="@color/Whoop.Gray.Light"
                            app:progressDialEndColor="@color/Whoop.Gradient.Blue.End"
                            app:progressDialStartColor="@color/Whoop.Gradient.Blue.Start"/>
                        <TextView
                            android:textAppearance="@style/Whoop.Text.MediumNumber"
                            android:textColor="@color/Whoop.Black"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/strainGoalMiniValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/Margin.Quarter"
                            android:fontFamily="@font/dinpro_bold"
                            android:layout_marginStart="@dimen/Margin.Standard"/>
                    </LinearLayout>
                    <ImageButton
                        android:layout_gravity="center_vertical"
                        android:id="@+id/lockedCoachHelpButton"
                        android:background="@null"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="@dimen/Margin.Triple"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_context_help_blackonwhite"/>
                    <TextView
                        android:textAppearance="@style/Whoop.Text.H2"
                        android:textColor="@color/Whoop.Gray.Dull"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/strainTargetHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/strain_coach"
                        android:maxLines="2"
                        android:textAllCaps="true"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:letterSpacing="0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.4"/>
                    <com.whoop.p069ui.WhoopSwitch
                        android:theme="@style/StrainCoach.Switch"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/strainCoachSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/Margin.Double"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.5"
                        app:whoopSwitchTextAppearance="@style/StrainCoach.Switch.Label"
                        app:whoopSwitchTextOff="@string/realtime_activity_action_off"
                        app:whoopSwitchTextOn="@string/realtime_activity_action_on"
                        app:whoopSwitchThumbColor="@color/Whoop.Gray.Light"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.whoop.p069ui.LockableNestedScrollView
                    android:id="@+id/coachScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/coachActiveContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/Margin.Double">
                            <com.whoop.realtime.presentation.views.StrainCoachGoalPicker
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/goalPicker"
                                android:padding="12dp"
                                android:layout_width="250dp"
                                android:layout_height="250dp"
                                android:layout_margin="@dimen/Margin.Standard"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:progressDialDrawEmptyArc="true"
                                app:progressDialEmptyColor="@color/Whoop.Gray.Light"
                                app:progressDialEndColor="@color/Whoop.Gradient.Blue.End"
                                app:progressDialGapLength="0"
                                app:progressDialStartColor="@color/Whoop.Gradient.Blue.Start"
                                app:progressDialThickness="15dp"
                                app:strainDialOptimalRangeColor="@color/Whoop.Gray.Light"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                app:layout_constraintBottom_toBottomOf="@+id/goalPicker"
                                app:layout_constraintLeft_toLeftOf="@+id/goalPicker"
                                app:layout_constraintRight_toRightOf="@+id/goalPicker"
                                app:layout_constraintTop_toTopOf="@+id/goalPicker">
                                <androidx.constraintlayout.widget.Guideline
                                    android:orientation="vertical"
                                    android:id="@+id/strain_dial_guideline_twenty_five"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintGuide_percent="0.25"/>
                                <androidx.constraintlayout.widget.Guideline
                                    android:orientation="vertical"
                                    android:id="@+id/strain_dial_guideline_seventy_five"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintGuide_percent="0.75"/>
                                <TextView
                                    android:textAppearance="@style/Whoop.Text.H2"
                                    android:gravity="center"
                                    android:id="@+id/activity_strain_tv"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="10dp"
                                    android:text="@string/realtime_activity_Strain_ActivityStrain"
                                    android:maxLines="3"
                                    android:textAllCaps="true"
                                    app:layout_constraintEnd_toStartOf="@+id/strain_dial_guideline_seventy_five"
                                    app:layout_constraintStart_toEndOf="@+id/strain_dial_guideline_twenty_five"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:textAppearance="@style/Whoop.Text.LargeNumber"
                                    android:textSize="68dp"
                                    android:textColor="@color/Whoop.Black"
                                    android:id="@+id/strainValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAllCaps="true"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/activity_strain_tv"/>
                                <TextView
                                    android:textAppearance="@style/Whoop.Text.H3"
                                    android:textColor="@color/Whoop.Gray"
                                    android:id="@+id/strainDescriptor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/Activity.RealTime.Strain.Restorative"
                                    android:textAllCaps="true"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/strainValue"/>
                                <ImageButton
                                    android:id="@+id/strainGoalResetButton"
                                    android:background="@null"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/Margin.Standard"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/strainDescriptor"
                                    app:srcCompat="@drawable/ic_reset"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/Margin.Standard">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/Margin.Standard"
                                app:srcCompat="@drawable/ic_whoop_w_circled"/>
                            <TextView
                                android:textSize="16dp"
                                android:textColor="#000000"
                                android:gravity="center_vertical"
                                android:id="@+id/strainCoachingCopy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/StrainCoach.Cardio.0"
                                android:lines="6"
                                android:fontFamily="@font/alphabetic_font_semibold"
                                android:layout_marginStart="@dimen/Margin.Standard"
                                android:layout_marginEnd="@dimen/Margin.Double"
                                android:layout_marginVertical="@dimen/Margin.Standard"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="0x7f07000e"
                            android:scaleType="fitXY"
                            app:srcCompat="@drawable/ic_sheet_handle"/>
                        <com.whoop.realtime.presentation.views.DayStrainView
                            android:id="@+id/dayStrainView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/Margin.Double"/>
                    </LinearLayout>
                </com.whoop.p069ui.LockableNestedScrollView>
                <FrameLayout
                    android:id="@+id/coachLockedContainer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="0x7f0806c9"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/Margin.Double"
                            app:srcCompat="@drawable/ic_lock"/>
                        <TextView
                            android:textAppearance="@style/Whoop.Text.H1"
                            android:textColor="@color/Whoop.Gray.Dull"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/strainTargetLockedHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/Margin.Double"
                            android:text="@string/strain_coach"
                            android:textAllCaps="true"/>
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/Whoop.Gray"
                            android:gravity="center"
                            android:id="@+id/coachLocked_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="0x7f07000e"
                            android:lines="3"
                            android:fontFamily="@font/alphabetic_font_semibold"
                            android:layout_marginHorizontal="0x7f07000e"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_buttons_container"
            android:background="@color/Whoop.Gray.SuperLight"
            android:padding="@dimen/Margin.Standard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coordin_root">
            <com.whoop.p069ui.pills.StrokedPillButton
                android:textAppearance="@style/Whoop.Text.H1.White"
                android:layout_gravity="center"
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/Activity.Start.StartWorkout"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/Margin.Double"
                android:layout_marginEnd="@dimen/Margin.Double"
                app:strokedPillColor="@color/Whoop.Red"
                app:strokedPillNormalAlpha="1"
                app:strokedPillUseStaticAlpha="false"
                style="@style/Button.Flat"/>
        </LinearLayout>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/activityListFragment"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbarContainer"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/toolbarContainer"
            android:background="@color/Activities.Start.Background.Toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/coordin_root"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:gravity="center_vertical"
                android:id="@+id/close"
                android:layout_width="?attr/actionBarSize"
                android:layout_height="match_parent"
                android:src="@drawable/ic_close"
                android:scaleType="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:contentDescription="@string/realtime_activity_action_close"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/activityContainer"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize">
                <com.whoop.p069ui.views.ColoredImageView
                    android:layout_gravity="center"
                    android:id="@+id/activityIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="@dimen/Margin.Half"
                    app:coloredImageViewColorFilter="@color/Whoop.White"/>
                <TextView
                    android:textSize="@dimen/text_size_large"
                    android:textColor="@color/Whoop.White"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/activityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:fontFamily="@font/alphabetic_font_semibold"
                    style="@style/Text.Default"/>
                <com.whoop.p069ui.views.ColoredImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/toolBarArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_down"
                    android:layout_marginStart="@dimen/Margin.Half"
                    app:coloredImageViewColorFilter="@color/Whoop.White"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
