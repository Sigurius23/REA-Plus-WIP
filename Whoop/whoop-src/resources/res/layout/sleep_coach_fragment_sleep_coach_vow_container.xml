<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.p018ui.platform.ComposeView
        android:id="@+id/compose_schedule_status_view"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/Margin.Standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/peak_bottom_back_ground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@color/black_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vow_text_container"/>
    <View
        android:background="@color/whoop_black_opacity_25"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/peak_bottom_back_ground"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vow_text_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/profile_icon"
            android:background="@drawable/ic_whoop_w_circled"
            android:layout_width="@dimen/sleep_coach_vow_logo_size"
            android:layout_height="@dimen/sleep_coach_vow_logo_size"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/sleep_coach_voice_of_whoop"
            android:backgroundTint="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/vow_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textAppearance="@style/Whoop.Sleep.VowStyle"
            android:gravity="center"
            android:id="@+id/vow_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="0x7f07000e"
            android:paddingEnd="0x7f07000e"
            android:layout_marginHorizontal="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.whoop.p069ui.ThrobberView
            android:id="@+id/throbber_view"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/profile_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="@style/Headline6_50"
        android:id="@+id/sleep_goal_shortcut_button_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/sleep_coach_tomorrow_i_want_to"
        app:layout_constraintBottom_toTopOf="@+id/sleep_goal_shortcut_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textAppearance="@style/Header.H4"
        android:id="@+id/sleep_goal_shortcut_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/vow_text_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vow_text_container"
        app:strokedPillStrokeColor="@color/white_70"/>
</androidx.constraintlayout.widget.ConstraintLayout>
