<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparent_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:background="@color/transparent_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="0x7f07000e"
        android:src="0x7f0805fc"
        android:scaleType="fitCenter"/>
    <ImageView
        android:background="@drawable/bg_black_gradient_transparent_inverted_with_center_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/Whoop.White"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0x7f07000e"
        android:text="@string/team_create_pitch"
        style="@style/Teams.Data"/>
</FrameLayout>
