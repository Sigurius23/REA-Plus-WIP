<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/choose_container"
    android:tag="layout/view_choose_gen4_bluetooth_device_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_8_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.08"/>
    <TextView
        android:id="@+id/connect_strap_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/searching_for_device"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_8_horizontal"
        style="@style/LegacyPairingFlow.HeadLine3"/>
    <TextView
        android:textColor="@color/white_50"
        android:id="@+id/connect_strap_body_gen4"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ensure_your_whoop_in_range"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/connect_strap_title"
        style="@style/Paragraph2"/>
    <ViewFlipper
        android:id="@+id/connect_strap_subtitle_view_flipper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:flipInterval="5000"
        android:autoStart="true"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/connect_strap_title">
        <TextView
            android:textColor="@color/white_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/make_sure_your_bluetooth_is_enabled"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            style="@style/Paragraph2"/>
        <TextView
            android:textColor="@color/white_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/double_tap_your_whoop"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            style="@style/Paragraph2"/>
        <TextView
            android:textColor="@color/white_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/take_your_whoop_off_your_wrist"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            style="@style/Paragraph2"/>
        <TextView
            android:textColor="@color/white_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/turn_on_pairing_mode"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            style="@style/Paragraph2"/>
        <TextView
            android:textColor="@color/white_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/charge_your_battery_pack_reminder"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"
            style="@style/Paragraph2"/>
    </ViewFlipper>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/half_screen_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.45"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/strap_list"
        android:fadingEdgeLength="60dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/ble_choose_strap_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/half_screen_guideline"/>
    <androidx.compose.p018ui.platform.ComposeView
        android:id="@+id/ble_choose_strap_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
