<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/stream_ui_borders_16dp_corners"
    android:layout_width="@dimen/stream_ui_message_composer_audio_attachment_width"
    android:layout_height="56dp">
    <io.getstream.chat.android.p226ui.feature.messages.list.adapter.view.internal.AudioRecordPlayerView
        android:layout_gravity="center"
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageButton
        android:layout_gravity="end|top"
        android:id="@+id/removeButton"
        android:background="@drawable/stream_ui_attachment_cancel_background"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/stream_ui_ic_close_white"
        android:cropToPadding="true"/>
</FrameLayout>
