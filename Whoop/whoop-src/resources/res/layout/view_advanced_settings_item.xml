<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_advanced_settings_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/advanced_settings_item_background"
        android:background="@drawable/bg_all_corners_rounded"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="@color/white_opacity10"
        app:layout_constraintBottom_toBottomOf="@+id/advanced_settings_item_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/advanced_settings_item_icon"
        android:padding="@dimen/Margin.Double"
        android:layout_width="50dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="@+id/advanced_settings_item_background"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white_50"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/advanced_settings_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@+id/advanced_settings_item_icon"
        app:layout_constraintEnd_toEndOf="@+id/advanced_settings_item_background"
        app:layout_constraintStart_toEndOf="@+id/advanced_settings_item_icon"
        app:layout_constraintTop_toTopOf="@+id/advanced_settings_item_icon"
        style="@style/Header.H4"/>
    <TextView
        android:textColor="@color/white_50"
        android:id="@+id/advanced_settings_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="0x7f07000e"
        android:layout_marginEnd="0x7f07000e"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/advanced_settings_item_icon"
        style="@style/Paragraph3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
