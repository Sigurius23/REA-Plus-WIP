<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/compose_message_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/Margin.StandardAndHalf"
    android:paddingVertical="@dimen/Margin.Standard">
    <TextView
        android:textColor="@color/white"
        android:id="@+id/command_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Headline4"/>
    <TextView
        android:textColor="@color/white_50"
        android:id="@+id/command_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Headline5"/>
</LinearLayout>
