<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/showcase_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.whoop.design.atomic.organism.toolbar.DesignToolbarView
        android:id="@+id/showcase_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/showcase_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        layout_constraintBottom_toBottomOf="parent"
        layout_constraintEnd_toEndOf="parent"
        layout_constraintStart_toStartOf="parent"
        layout_constraintTop_toBottomOf="@+id/showcase_toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
