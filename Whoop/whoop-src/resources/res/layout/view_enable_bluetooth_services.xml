<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/view_enable_bluetooth_services_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/background_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0x7f07000e"
        android:src="@drawable/bg_enable_bluetooth_permission"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Standard"
        android:text="@string/bluetooth_required"
        app:layout_constraintLeft_toLeftOf="@+id/background_image"
        app:layout_constraintRight_toRightOf="@+id/background_image"
        app:layout_constraintTop_toBottomOf="@+id/background_image"
        style="@style/StrapSettingsTitleStyle"/>
    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/Margin.Standard"
        android:text="@string/bluetooth_required_text"
        app:layout_constraintLeft_toLeftOf="@+id/background_image"
        app:layout_constraintRight_toRightOf="@+id/background_image"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/StrapSettingsMessageStyle"/>
    <com.whoop.p069ui.pills.StrokedPillButton
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/enable_bluetooth_button_new"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/StrapStatus_Action_EnableBluetooth"
        android:fontFamily="@font/alphabetic_font_bold"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="35dp"
        android:letterSpacing="0.1"
        app:layout_constraintLeft_toLeftOf="@+id/background_image"
        app:layout_constraintRight_toRightOf="@+id/background_image"
        app:layout_constraintTop_toBottomOf="@+id/message"
        app:strokedPillColor="@color/white"
        app:strokedPillNormalAlpha="0"
        app:strokedPillUseStaticAlpha="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
