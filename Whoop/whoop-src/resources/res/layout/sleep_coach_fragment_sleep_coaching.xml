<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sleep_coach_cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sleep_coach_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/sleep_coaching_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="start"
            android:id="@+id/title_sleep_coach"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sleep_performance_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sleep_Coaching_Tab_Text"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/sleep_performance_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sleep_performance_tv_goal"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sleep_Coaching_Tab_Text"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/sleep_performance_tv_goal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:drawableEndCompat="@drawable/ic_arrow_chevron_right"
            app:drawableTint="@color/white_50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sleep_Coaching_Tab_Text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sleep_coaching_container"
        android:background="@drawable/bg_coaching_rounded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_coach_title_container"
        app:layout_goneMarginBottom="30dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sleep_suggestion_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintBottom_toTopOf="@+id/view_sleep_coach_onboarding_widget"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="20dp">
            <TextView
                android:textSize="0x7f07007d"
                android:textColor="@color/Whoop.Sleep"
                android:gravity="bottom"
                android:id="@+id/sleep_duration_tv"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="@string/sleep_coach_time_placeholder"
                android:fontFamily="@font/dinpro_bold"
                app:layout_constraintBottom_toTopOf="@+id/recommended_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_9_sp"
                android:textColor="@color/whoop_blue_light_translucent"
                android:gravity="center"
                android:id="@+id/recommended_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sleep_coach_time_in_bed_formatted"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="@+id/sleep_duration_tv"
                app:layout_constraintStart_toStartOf="@+id/sleep_duration_tv"
                app:layout_constraintTop_toBottomOf="@+id/sleep_duration_tv"
                style="@style/Sleep_Coaching_Tab_Text"/>
            <TextView
                android:textSize="@dimen/text_size_9_sp"
                android:textColor="@color/whoop_blue_light_translucent"
                android:gravity="center"
                android:id="@+id/recommended_to_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="@+id/recommended_tv"
                app:layout_constraintStart_toStartOf="@+id/recommended_tv"
                app:layout_constraintTop_toBottomOf="@+id/recommended_tv"
                style="@style/Sleep_Coaching_Tab_Text"/>
            <TextView
                android:textSize="0x7f070081"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/bed_time_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_coach_double_dash"
                android:drawablePadding="5dp"
                android:fontFamily="@font/dinpro_bold"
                app:drawableTint="@color/white_50"
                app:drawableTopCompat="@drawable/ic_sun_down"
                app:layout_constraintBottom_toTopOf="@+id/recommended_tv"
                app:layout_constraintEnd_toEndOf="@+id/dashedLine1"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_9_sp"
                android:textStyle="bold"
                android:textColor="@color/white_50"
                android:gravity="center"
                android:id="@+id/bed_time_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sleep_coach_bed_time"
                android:textAllCaps="true"
                android:fontFamily="@font/alphabetic_font_bold"
                android:letterSpacing="0.09"
                app:layout_constraintEnd_toEndOf="@+id/bed_time_value_tv"
                app:layout_constraintStart_toStartOf="@+id/bed_time_value_tv"
                app:layout_constraintTop_toBottomOf="@+id/bed_time_value_tv"/>
            <View
                android:id="@+id/dashedLine1"
                android:background="@drawable/shape_dashed_line"
                android:layout_width="25dp"
                android:layout_height="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:foregroundTint="@color/white"
                app:layout_constraintBottom_toTopOf="@+id/recommended_tv"
                app:layout_constraintEnd_toStartOf="@+id/sleep_duration_tv"
                app:layout_constraintStart_toEndOf="@+id/bed_time_value_tv"/>
            <TextView
                android:textSize="0x7f070081"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/wake_up_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_coach_double_dash"
                android:drawablePadding="5dp"
                android:fontFamily="@font/dinpro_bold"
                app:drawableTint="@color/white_50"
                app:drawableTopCompat="@drawable/ic_sun_up"
                app:layout_constraintBottom_toTopOf="@+id/recommended_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/dashedLine2"/>
            <TextView
                android:textSize="@dimen/text_size_9_sp"
                android:textStyle="bold"
                android:textColor="@color/white_50"
                android:gravity="center"
                android:id="@+id/wake_up_time_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/sleep_coach_wake_time"
                android:textAllCaps="true"
                android:fontFamily="@font/alphabetic_font_bold"
                android:letterSpacing="0.09"
                app:layout_constraintEnd_toEndOf="@+id/wake_up_value_tv"
                app:layout_constraintStart_toStartOf="@+id/wake_up_value_tv"
                app:layout_constraintTop_toBottomOf="@+id/wake_up_value_tv"/>
            <View
                android:id="@+id/dashedLine2"
                android:background="@drawable/shape_dashed_line"
                android:layout_width="25dp"
                android:layout_height="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:foregroundTint="@color/white"
                app:layout_constraintBottom_toTopOf="@+id/recommended_tv"
                app:layout_constraintEnd_toStartOf="@+id/wake_up_time_tv"
                app:layout_constraintStart_toEndOf="@+id/sleep_duration_tv"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sleep_coaching_landing_alarm_widget_bg"
                android:background="@drawable/bg_sleep_coach_alarm_status_widget_exact_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingHorizontal="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/wake_up_time_tv"
                app:layout_constraintStart_toStartOf="@+id/wake_up_time_tv"
                app:layout_constraintTop_toBottomOf="@+id/wake_up_time_tv"
                app:layout_constraintVertical_bias="0">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/sleep_coaching_landing_alarm_widget_strap_ic"
                    android:background="@drawable/ic_strap_alarm_on"
                    android:layout_width="11dp"
                    android:layout_height="13dp"
                    android:contentDescription="@string/sleep_coach_alarm_status"
                    android:layout_marginEnd="5dp"/>
                <TextView
                    android:textSize="@dimen/text_size_9_sp"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/sleep_coaching_landing_alarm_widget_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    style="@style/Headline6"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/view_sleep_coach_onboarding_widget"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginVertical="10dp"
            app:layout_constraintBottom_toTopOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleep_suggestion_container"
            layout="@layout/sleep_coach_view_sleep_coach_onboarding_widget"/>
        <View
            android:id="@+id/divider"
            android:background="@color/black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/mcc_pill_on_sleep"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_sleep_coach_onboarding_widget"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mcc_pill_on_sleep"
            android:padding="15dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <TextView
                android:id="@+id/sleep_efficiency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_coach_sleep_efficiency_colon"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Headline6"/>
            <TextView
                android:id="@+id/sleep_efficiency_tolerance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/sleep_efficiency"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Headline6"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
