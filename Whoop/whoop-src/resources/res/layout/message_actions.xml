<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_action_layout"
    android:tag="layout/message_actions_0"
    android:background="@drawable/bg_rounded_corner_sheet"
    android:paddingBottom="@dimen/Margin.Triple"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <ImageView
        android:id="@+id/message_action_handler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Margin.Double"
        android:src="@drawable/ic_sheet_handle"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/emote_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="emote_love,emote_like,emote_dislike,emote_haha,emote_wow,emote_cry,emote_strong"/>
    <ImageView
        android:id="@+id/emote_love"
        android:layout_marginTop="@dimen/Margin.Double"
        android:src="0x7f0804c1"
        android:layout_marginStart="@dimen/Margin.Double"
        app:layout_constraintEnd_toStartOf="@+id/emote_like"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_action_handler"
        style="@style/Chat.ActionReaction"/>
    <ImageView
        android:id="@+id/emote_like"
        android:src="0x7f0804cb"
        app:layout_constraintBottom_toBottomOf="@+id/emote_love"
        app:layout_constraintEnd_toStartOf="@+id/emote_dislike"
        app:layout_constraintStart_toEndOf="@+id/emote_love"
        app:layout_constraintTop_toTopOf="@+id/emote_love"
        style="@style/Chat.ActionReaction"/>
    <ImageView
        android:id="@+id/emote_dislike"
        android:src="0x7f0804c9"
        app:layout_constraintBottom_toBottomOf="@+id/emote_like"
        app:layout_constraintEnd_toStartOf="@+id/emote_haha"
        app:layout_constraintStart_toEndOf="@+id/emote_like"
        app:layout_constraintTop_toTopOf="@+id/emote_like"
        style="@style/Chat.ActionReaction"/>
    <ImageView
        android:id="@+id/emote_haha"
        android:src="0x7f0804c5"
        app:layout_constraintBottom_toBottomOf="@+id/emote_dislike"
        app:layout_constraintEnd_toStartOf="@+id/emote_wow"
        app:layout_constraintStart_toEndOf="@+id/emote_dislike"
        app:layout_constraintTop_toTopOf="@+id/emote_dislike"
        style="@style/Chat.ActionReaction"/>
    <ImageView
        android:id="@+id/emote_wow"
        android:src="0x7f0804c3"
        app:layout_constraintBottom_toBottomOf="@+id/emote_haha"
        app:layout_constraintEnd_toStartOf="@+id/emote_cry"
        app:layout_constraintStart_toEndOf="@+id/emote_haha"
        app:layout_constraintTop_toTopOf="@+id/emote_haha"
        style="@style/Chat.ActionReaction"/>
    <ImageView
        android:id="@+id/emote_cry"
        android:src="0x7f0804bf"
        app:layout_constraintBottom_toBottomOf="@+id/emote_wow"
        app:layout_constraintEnd_toStartOf="@+id/emote_strong"
        app:layout_constraintStart_toEndOf="@+id/emote_wow"
        app:layout_constraintTop_toTopOf="@+id/emote_wow"
        style="@style/Chat.ActionReaction"/>
    <ImageView
        android:id="@+id/emote_strong"
        android:src="0x7f0804c7"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:layout_constraintBottom_toBottomOf="@+id/emote_cry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/emote_cry"
        app:layout_constraintTop_toTopOf="@+id/emote_cry"
        style="@style/Chat.ActionReaction"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_reactions_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="emote_love,emote_like,emote_dislike,emote_haha,emote_wow,emote_cry,emote_strong"/>
    <TextView
        android:textColor="@color/Whoop.Black"
        android:gravity="start|center_vertical"
        android:id="@+id/message_action_reply"
        android:background="@drawable/bg_message_action"
        android:paddingTop="@dimen/Margin.Standard"
        android:paddingBottom="@dimen/Margin.Standard"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/Margin.Double"
        android:text="@string/community_qa_comment_reply"
        android:drawablePadding="@dimen/Margin.Double"
        android:paddingStart="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:drawableStartCompat="@drawable/ic_message_reply"
        app:layout_constraintBottom_toTopOf="@+id/message_action_copy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier_reactions_bottom"
        style="@style/Headline4"/>
    <TextView
        android:textColor="@color/Whoop.Black"
        android:gravity="start|center_vertical"
        android:id="@+id/message_action_copy"
        android:background="@drawable/bg_message_action"
        android:paddingTop="@dimen/Margin.Standard"
        android:paddingBottom="@dimen/Margin.Standard"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/Margin.StandardAndHalf"
        android:layout_marginBottom="@dimen/Margin.StandardAndHalf"
        android:text="@string/message_action_copy"
        android:drawablePadding="@dimen/Margin.Double"
        android:paddingStart="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:drawableStartCompat="@drawable/ic_message_copy"
        app:layout_constraintBottom_toTopOf="@+id/message_action_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_action_reply"
        style="@style/Headline4"/>
    <TextView
        android:textColor="@color/Whoop.Black"
        android:gravity="start|center_vertical"
        android:id="@+id/message_action_edit"
        android:background="@drawable/bg_message_action"
        android:paddingTop="@dimen/Margin.Standard"
        android:paddingBottom="@dimen/Margin.Standard"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/Margin.StandardAndHalf"
        android:text="@string/message_action_edit"
        android:drawablePadding="@dimen/Margin.Double"
        android:paddingStart="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:drawableStartCompat="@drawable/ic_message_edit"
        app:layout_constraintBottom_toTopOf="@+id/message_action_delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_action_copy"
        style="@style/Headline4"/>
    <TextView
        android:textColor="@color/Whoop.Black"
        android:gravity="start|center_vertical"
        android:id="@+id/message_action_delete"
        android:background="@drawable/bg_message_action"
        android:paddingTop="@dimen/Margin.Standard"
        android:paddingBottom="@dimen/Margin.Standard"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/Margin.StandardAndHalf"
        android:text="@string/community_action_delete"
        android:drawablePadding="@dimen/Margin.Double"
        android:paddingStart="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:drawableStartCompat="@drawable/ic_message_delete"
        app:layout_constraintBottom_toTopOf="@+id/message_action_report"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_action_edit"
        style="@style/Headline4"/>
    <TextView
        android:textColor="@color/Whoop.Black"
        android:gravity="start|center_vertical"
        android:id="@+id/message_action_report"
        android:background="@drawable/bg_message_action"
        android:paddingTop="@dimen/Margin.Standard"
        android:paddingBottom="@dimen/Margin.Standard"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:text="@string/ama_report"
        android:drawablePadding="@dimen/Margin.Double"
        android:paddingStart="@dimen/Margin.Double"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:drawableStartCompat="@drawable/ic_message_report"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_action_delete"
        style="@style/Headline4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
