<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/view_enable_location_services_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.whoop.p069ui.views.ColoredImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_location_pin"
            app:coloredImageViewColorFilter="@color/Whoop.Blue"/>
        <TextView
            android:textSize="@dimen/text_size_slightly_huge"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Standard"
            android:layout_marginBottom="@dimen/Margin.Standard"
            android:text="@string/location_services_required"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:letterSpacing="0.1"/>
        <TextView
            android:textSize="@dimen/text_size_standard"
            android:textColor="@color/white_50"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/location_enable_text"
            android:fontFamily="@font/alphabetic_font_semibold"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="60dp"/>
        <com.whoop.p069ui.pills.StrokedPillButton
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/enable_location_services_button"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/enable_location_services"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="35dp"
            android:letterSpacing="0.1"
            app:strokedPillColor="@color/white"
            app:strokedPillNormalAlpha="0"
            app:strokedPillUseStaticAlpha="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
