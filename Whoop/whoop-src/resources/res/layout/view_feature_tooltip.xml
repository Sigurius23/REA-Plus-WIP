<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_tooltip"
    android:tag="layout/view_feature_tooltip_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/feature_tooltip_default_margin"
    android:layout_marginBottom="@dimen/feature_tooltip_default_margin"
    android:layout_marginStart="@dimen/feature_tooltip_default_margin"
    android:layout_marginEnd="@dimen/feature_tooltip_default_margin">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_tooltip_frame"
        android:background="@drawable/bg_feature_tooltip"
        android:padding="@dimen/feature_tooltip_frame_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_13_sp"
            android:textColor="@color/feature_tooltip_title"
            android:id="@+id/view_tooltip_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:letterSpacing="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_12_sp"
            android:textColor="@color/feature_tooltip_description"
            android:id="@+id/view_tooltip_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_tooltip_description_marginTop"
            android:lineSpacingExtra="@dimen/feature_tooltip_description_line_spacing_extra"
            android:fontFamily="@font/alphabetic_font_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_tooltip_title"/>
        <TextView
            android:textSize="@dimen/text_size_11_sp"
            android:textColor="@color/feature_tooltip_cta_label"
            android:gravity="center"
            android:id="@+id/view_tooltip_cta_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_tooltip_cta_marginTop"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:letterSpacing="0.1"
            app:layout_constraintEnd_toStartOf="@+id/cta_indicator"
            app:layout_constraintTop_toBottomOf="@+id/view_tooltip_description"/>
        <ImageView
            android:id="@+id/cta_indicator"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/ic_arrow_forward"
            app:layout_constraintBottom_toBottomOf="@+id/view_tooltip_cta_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_tooltip_cta_button"/>
        <View
            android:id="@+id/cta_clickable_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_tooltip_cta_button"
            app:layout_constraintEnd_toEndOf="@+id/cta_indicator"
            app:layout_constraintStart_toStartOf="@+id/view_tooltip_cta_button"
            app:layout_constraintTop_toTopOf="@+id/view_tooltip_cta_button"/>
        <com.whoop.p069ui.DotProgressIndicator
            android:id="@+id/dot_progress_indicator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            app:dotProgressIndicatorCircleSpacing="8dp"
            app:dotProgressIndicatorSelectedColor="@color/Whoop.White"
            app:dotProgressIndicatorUnselectedColor="@color/Whoop.Gray.Dull"
            app:horizontalProgressPosition="left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_tooltip_cta_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.whoop.p069ui.views.ColoredImageView
        android:id="@+id/view_tooltip_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_up_white"/>
</FrameLayout>
