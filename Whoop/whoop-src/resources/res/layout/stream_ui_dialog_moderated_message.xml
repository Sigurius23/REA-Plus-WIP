<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/stream_ui_white_shape_8dp_corners"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/stream_ui_ic_flag"
            app:tint="@color/stream_ui_accent_blue"/>
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/stream_ui_moderation_dialog_title"
            style="@style/StreamUiTextAppearance.HeadlineBold"/>
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stream_ui_moderation_dialog_description"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            style="@style/StreamUiTextAppearance.Body"/>
        <View
            android:background="@drawable/stream_ui_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textColor="@color/stream_ui_accent_blue"
            android:gravity="center"
            android:id="@+id/sendAnyway"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/stream_ui_moderation_dialog_send"
            style="@style/StreamUiTextAppearance.Body"/>
        <View
            android:background="@drawable/stream_ui_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textColor="@color/stream_ui_accent_blue"
            android:gravity="center"
            android:id="@+id/editMessage"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/stream_ui_moderation_dialog_edit"
            style="@style/StreamUiTextAppearance.Body"/>
        <View
            android:background="@drawable/stream_ui_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textColor="@color/stream_ui_accent_blue"
            android:gravity="center"
            android:id="@+id/deleteMessage"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/stream_ui_moderation_dialog_delete"
            style="@style/StreamUiTextAppearance.Body"/>
    </LinearLayout>
</FrameLayout>
