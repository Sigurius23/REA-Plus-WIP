<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/select_team_item_view_0"
    android:background="@drawable/bg_community_user_team"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/Margin.Standard"
    android:layout_marginVertical="@dimen/Margin.Half"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/select_team_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="@dimen/Margin.Standard"
        android:src="@drawable/ic_user_avatar_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/select_team_name"
        android:layout_margin="@dimen/Margin.Double"
        android:text="@string/community_team_name_placeholder"
        android:maxLines="1"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toBottomOf="@+id/select_team_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/select_team_icon"
        app:layout_constraintTop_toTopOf="@+id/select_team_icon"
        style="@style/Headline4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
