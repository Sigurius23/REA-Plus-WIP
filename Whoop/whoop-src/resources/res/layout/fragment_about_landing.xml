<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_root_container"
    android:background="@drawable/drawer_background_gradient_color"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.whoop.p069ui.WhoopNewToolbar
        android:id="@+id/about_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backArrowIcon="@drawable/ic_close"
        app:layout_constraintTop_toTopOf="parent"
        app:toolbarBackgroundColor="@android:color/transparent"
        app:toolbarTitle="@string/about"
        app:toolbarTitleColor="@color/white"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/privacy_policy_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/about_toolbar"
        style="@style/SettingLandingItem">
        <com.whoop.p069ui.views.ColoredImageView
            android:id="@+id/privacy_policy_icon"
            android:layout_width="@dimen/Settings.IconSize"
            android:layout_height="@dimen/Settings.IconSize"
            android:src="@drawable/ic_privacy_policy_white"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/privacy_policy_label"
            android:text="@string/privacy_policy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/privacy_policy_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SettingsItemLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/term_of_service_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privacy_policy_layout"
        style="@style/SettingLandingItem">
        <com.whoop.p069ui.views.ColoredImageView
            android:id="@+id/term_of_service_icon"
            android:layout_width="@dimen/Settings.IconSize"
            android:layout_height="@dimen/Settings.IconSize"
            android:src="@drawable/ic_terms_of_use_white"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/term_of_service_label"
            android:text="@string/settings_terms_of_services"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/term_of_service_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SettingsItemLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/open_source_licenses_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/term_of_service_layout"
        style="@style/SettingLandingItem">
        <com.whoop.p069ui.views.ColoredImageView
            android:id="@+id/open_source_licenses_icon"
            android:layout_width="@dimen/Settings.IconSize"
            android:layout_height="@dimen/Settings.IconSize"
            android:src="@drawable/ic_terms_of_use_white"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/open_source_licenses_label"
            android:text="@string/open_source_licenses"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/open_source_licenses_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SettingsItemLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/patents_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/open_source_licenses_layout"
        style="@style/SettingLandingItem">
        <com.whoop.p069ui.views.ColoredImageView
            android:id="@+id/patents_icon"
            android:layout_width="@dimen/Settings.IconSize"
            android:layout_height="@dimen/Settings.IconSize"
            android:src="@drawable/ic_terms_of_use_white"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/patents_label"
            android:text="@string/patents"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/patents_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SettingsItemLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/safety_regulatory_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/patents_layout"
        style="@style/SettingLandingItem">
        <com.whoop.p069ui.views.ColoredImageView
            android:id="@+id/safety_regulatory_icon"
            android:layout_width="@dimen/Settings.IconSize"
            android:layout_height="@dimen/Settings.IconSize"
            android:src="@drawable/ic_terms_of_use_white"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:text="@string/safety_regulatory"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/safety_regulatory_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SettingsItemLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/regulatory_labels_layout"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/safety_regulatory_layout"
        style="@style/SettingLandingItem">
        <com.whoop.p069ui.views.ColoredImageView
            android:id="@+id/regulatory_labels_icon"
            android:layout_width="@dimen/Settings.IconSize"
            android:layout_height="@dimen/Settings.IconSize"
            android:src="@drawable/ic_regulatory_labels_white"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/regulatory_labels_label"
            android:text="@string/regulatory_labels"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/regulatory_labels_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SettingsItemLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
