<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/Margin.Half"
    android:layout_marginBottom="@dimen/Margin.Half">
    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_gravity="center"
        android:id="@+id/itemImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/Margin.Standard"
        android:src="@drawable/ic_user_avatar_default"
        android:layout_centerInParent="true"
        app:srcCompat="@drawable/ic_user_avatar_default"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/Margin.Standard">
        <TextView
            android:textColor="@color/Whoop.Gray.Dark"
            android:id="@+id/itemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Teams.UserName"/>
        <TextView
            android:textColor="@color/Whoop.Gray.SlightlyDark"
            android:id="@+id/itemData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Teams.Data"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/removeButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="@dimen/Margin.Standard"
        android:src="@drawable/ic_close_circled"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/transferButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="@dimen/Margin.Standard"
        android:src="@drawable/ic_admin_circled"/>
</LinearLayout>
