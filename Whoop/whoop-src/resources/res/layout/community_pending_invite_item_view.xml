<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/community_pending_invite_item_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/community_landing_invite_cardview"
        android:background="@drawable/bg_community_user_team"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/Margin.Half"
        app:layout_constraintTop_toTopOf="parent">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/community_pending_team_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="@dimen/Margin.Standard"
            android:src="@drawable/ic_user_avatar_default"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:textColor="@color/Whoop.Gray.Light.Transparent"
            android:ellipsize="end"
            android:id="@+id/community_pending_invite_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="@dimen/Margin.Standard"
            android:layout_marginEnd="@dimen/Margin.Standard"
            android:letterSpacing="0.05"
            app:layout_constraintEnd_toStartOf="@+id/community_pending_team_sender_icon"
            app:layout_constraintStart_toEndOf="@+id/community_pending_team_icon"
            app:layout_constraintTop_toTopOf="@+id/community_pending_team_icon"/>
        <TextView
            android:textSize="@dimen/text_size_13"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/community_pending_team_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAllCaps="true"
            android:fontFamily="@font/alphabetic_font_bold"
            android:layout_marginStart="@dimen/Margin.Standard"
            android:layout_marginEnd="@dimen/Margin.Standard"
            android:letterSpacing="0.05"
            app:layout_constraintBottom_toBottomOf="@+id/community_pending_team_icon"
            app:layout_constraintEnd_toStartOf="@+id/community_pending_team_sender_icon"
            app:layout_constraintStart_toEndOf="@+id/community_pending_team_icon"
            app:layout_constraintTop_toBottomOf="@+id/community_pending_invite_message"/>
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/community_pending_team_sender_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="@dimen/Margin.Standard"
            android:src="@drawable/ic_user_avatar_default"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/community_pending_seen_badge"
        android:visibility="visible"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_badge_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
