<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alarm_loadingHolder"
    android:background="@color/black_opacity_90"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/saving_state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/progress_bar_spinner"
            android:background="@drawable/set_alarm_loading_drawable_circle"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:max="100"
            android:indeterminate="false"
            android:progressDrawable="@drawable/smart_alarm_circular_progress"
            app:layout_constraintBottom_toTopOf="@+id/saving_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="?android:attr/progressBarStyleHorizontal"/>
        <ImageView
            android:id="@+id/strap_loading"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_strap"
            app:layout_constraintBottom_toBottomOf="@+id/progress_bar_spinner"
            app:layout_constraintEnd_toEndOf="@+id/progress_bar_spinner"
            app:layout_constraintStart_toStartOf="@+id/progress_bar_spinner"
            app:layout_constraintTop_toTopOf="@+id/progress_bar_spinner"/>
        <TextView
            android:id="@+id/saving_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Triple"
            app:layout_constraintBottom_toTopOf="@+id/saving_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_bar_spinner"
            style="@style/Headline3"/>
        <TextView
            android:textColor="@color/white_50"
            android:gravity="center"
            android:id="@+id/saving_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.StandardAndHalf"
            android:text="@string/sleep_coach_smart_alarm_saving_description"
            android:paddingStart="@dimen/Margin.nonuple"
            android:paddingEnd="@dimen/Margin.nonuple"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/saving_title"
            style="@style/Paragraph1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/success_state_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/alarm_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shape_success_with_circle"
            app:layout_constraintBottom_toTopOf="@+id/alarm_saved_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:id="@+id/alarm_saved_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Triple"
            android:text="@string/sleep_coach_alarm_prefs_saving"
            app:layout_constraintBottom_toTopOf="@+id/alarm_saved_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/alarm_set"
            style="@style/Headline3"/>
        <TextView
            android:textColor="@color/white_50"
            android:gravity="center"
            android:id="@+id/alarm_saved_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.StandardAndHalf"
            android:text="@string/sleep_coach_smart_alarm_set"
            android:paddingStart="@dimen/Margin.nonuple"
            android:paddingEnd="@dimen/Margin.nonuple"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/alarm_saved_title"
            style="@style/Paragraph1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/error_state_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/error_saving"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_alert_circle"
            app:layout_constraintBottom_toTopOf="@+id/error_loading_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:id="@+id/error_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.Triple"
            android:text="@string/sleep_coach_alarm_prefs_saving_failed"
            app:layout_constraintBottom_toTopOf="@+id/error_loading_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_saving"
            style="@style/Headline3"/>
        <TextView
            android:textColor="@color/white_50"
            android:gravity="center"
            android:id="@+id/error_loading_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.StandardAndHalf"
            android:text="@string/sleep_coach_alarm_prefs_saving_fail_description"
            android:paddingStart="@dimen/Margin.nonuple"
            android:paddingEnd="@dimen/Margin.nonuple"
            app:layout_constraintBottom_toTopOf="@+id/retry_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_loading_title"
            style="@style/Paragraph1"/>
        <com.whoop.p069ui.pills.StrokedPillButton
            android:textAppearance="@style/Whoop.Text.H2"
            android:textColor="@drawable/selector_sleep_coach_text_enabled"
            android:id="@+id/retry_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.DoubleAndHalf"
            android:text="@string/sleep_coach_smart_alarm_retry"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintBottom_toTopOf="@+id/cancel_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/error_loading_description"
            app:strokedPillColor="@color/whoop_red"
            app:strokedPillNormalAlpha="0"
            app:strokedPillStrokeColor="@color/whoop_red"
            style="@style/Button.StrokedPill"/>
        <TextView
            android:textAppearance="@style/Whoop.Text.H2"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/cancel_button"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Margin.ContentInset"
            android:text="@string/sleep_coach_smart_alarm_upload_cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/retry_button"
            style="@style/Headline4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
