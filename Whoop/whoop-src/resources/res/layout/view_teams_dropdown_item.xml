<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/whoop_background"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/teams_dropdown_item_checkmark"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:tint="@color/Whoop.White"
        android:layout_marginStart="@dimen/Margin.Double"
        android:layout_marginEnd="@dimen/Margin.Double"
        app:srcCompat="@drawable/ic_check"/>
    <TextView
        android:textSize="@dimen/text_size_standard"
        android:textColor="@color/Whoop.White"
        android:layout_gravity="center_vertical"
        android:id="@+id/teams_dropdown_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/List.Item.Text"/>
    <TextView
        android:textSize="@dimen/text_size_standard"
        android:textColor="@color/Whoop.Gray"
        android:layout_gravity="center_vertical"
        android:id="@+id/teams_dropdown_item_sortby"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_by"
        android:textAllCaps="false"
        style="@style/List.Item.Text"/>
</LinearLayout>
