<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@anim/Anim.Transition.Zoom.Interpolator">
    <alpha
        android:duration="@integer/Anim.Transition.Zoom.Duration"
        android:fillBefore="false"
        android:fillAfter="true"
        android:fromAlpha="0"
        android:toAlpha="1"
        android:fillEnabled="true"/>
    <scale
        android:duration="@integer/Anim.Transition.Zoom.Duration"
        android:pivotX="50%p"
        android:pivotY="50%p"
        android:fromXScale="0.4"
        android:toXScale="1"
        android:fromYScale="0.4"
        android:toYScale="1"/>
</set>
