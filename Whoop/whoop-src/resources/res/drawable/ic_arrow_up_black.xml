<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="20dp"
        android:width="20dp"
        android:left="20dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="0"
            android:pivotY="0">
            <shape>
                <solid android:color="@color/whoopBlack"/>
                <stroke
                    android:width="2dp"
                    android:color="@color/purple_gradient_end"/>
                <corners android:radius="2dp"/>
            </shape>
        </rotate>
    </item>
    <item
        android:height="14dp"
        android:width="27dp"
        android:left="7dp"
        android:top="14dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/whoopBlack"/>
        </shape>
    </item>
</layer-list>
