<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/pink_gradient_start"
                android:endColor="@color/purple_gradient_end"
                android:angle="270"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#101518"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</layer-list>
